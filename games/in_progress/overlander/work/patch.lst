                            	    25: ; Relocated Address Table (filled & added to GEMDOS reloc table by build script)
                            	    26: ; ============================================================================
                            	    27:                         align   2
00:00000030 00000000        	    28: ptr_game_base:          dc.l    0                       ; +0x0030 -> base of OVERLAND_orig.PRG (+0x00000)
00:00000034 00000000        	    29: ptr_orig_start:         dc.l    0                       ; +0x0034 -> +0x0011c (original entry $abb6)
00:00000038 00000000        	    30: ptr_scr_bufs:           dc.l    0                       ; +0x0038 -> BSS: 3 * 32000 + 256 bytes
00:0000003C 00000000        	    31: ptr_g_tos_buf:          dc.l    0                       ; +0x003c -> BSS: $3b000 bytes for G.TOS
00:00000040 00000000        	    32: ptr_lowram_bss:         dc.l    0                       ; +0x0040 -> BSS: $8000 bytes ($0800..$8800)
00:00000044 00000000        	    33: ptr_orig_sky_cont:      dc.l    0                       ; +0x0044 -> +0x03d46 ($00e7e0)
00:00000048 00000000        	    34: ptr_orig_sky_done:      dc.l    0                       ; +0x0048 -> +0x03d92 ($00e82c)
00:0000004C 00000000        	    35: ptr_orig_road_cont:     dc.l    0                       ; +0x004c -> +0x0cd92 ($01782c)
00:00000050 00000000        	    36: ptr_mask_buf:           dc.l    0                       ; +0x0050 -> BSS: $f000 bytes (60 KB G.TOS masks)
00:00000054 00000000        	    37: ptr_orig_mtn_cont:      dc.l    0                       ; +0x0054 -> +0x0368e ($00e128)
00:00000058 00000000        	    38: ptr_orig_spr_aln_cont:  dc.l    0                       ; +0x0058 -> +0x0322e ($00dcc8)
00:0000005C 00000000        	    39: ptr_orig_spr_scl_cont:  dc.l    0                       ; +0x005c -> +0x03832 ($00e2cc)

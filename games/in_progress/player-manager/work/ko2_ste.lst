                            	   680: ; ---------------------------------------------------------------------------
                            	   681: ; Sprite Draw Core ($01a426) & Erase ($01a83e) — STE Blitter 4bpp Masked!
                            	   682: ; All 4 KO2 sprite entry points ($01a2fc, $01a346, $01a3bc, $01a412) save
                            	   683: ; movem.l d0-d2/d4/d7/a0-a1/a3,-(sp) and enter $01a426 with d0=x, d1=y, a1=src, a3=rec!
                            	   684: ; ---------------------------------------------------------------------------
                            	   685: ste_skip_beam_1:
00:000AF0C4 4A79000AE964    	   686:         tst.w   STE_AMIGA_ON
00:000AF0CA 6708            	   687:         beq.s   .sb1_st
00:000AF0CC 612E            	   688:         bsr.s   ste_wait_beam           ; Amiga STE: exact 20-line beam-avoidance window (ZERO flicker, 50 FPS!)
00:000AF0CE 4EF90001A39C    	   689:         jmp     $01a39c.l
                            	   690: .sb1_st:
00:000AF0D4 282CECE0        	   691:         move.l  -$1320(a4),d4
00:000AF0D8 3404            	   692:         move.w  d4,d2
00:000AF0DA 4EF90001A37C    	   693:         jmp     $01a37c.l
                            	   694: 
                            	   695: ste_skip_beam_2:
00:000AF0E0 4A79000AE964    	   696:         tst.w   STE_AMIGA_ON
00:000AF0E6 6708            	   697:         beq.s   .sb2_st
00:000AF0E8 6112            	   698:         bsr.s   ste_wait_beam           ; Amiga STE: exact 20-line beam-avoidance window (ZERO flicker, 50 FPS!)
00:000AF0EA 4EF90001A3F2    	   699:         jmp     $01a3f2.l
                            	   700: .sb2_st:
00:000AF0F0 282CECE0        	   701:         move.l  -$1320(a4),d4
00:000AF0F4 3404            	   702:         move.w  d4,d2
00:000AF0F6 4EF90001A3D2    	   703:         jmp     $01a3d2.l
                            	   704: 
                            	   705: ; KO2-style STE hardware raster-beam avoidance window:
                            	   706: ; Waits ONLY if the video beam is inside [sprite_y - 16 .. sprite_y + 18] scanlines!
                            	   707: ; When beam is in top/bottom border, above sprite-16, or below sprite+18 -> ZERO WAIT!
                            	   708: ste_wait_beam:
00:000AF0FC 48E72900        	   709:         movem.l d2/d4/d7,-(sp)
00:000AF100 3801            	   710:         move.w  d1,d4
00:000AF102 C8FC00A8        	   711:         mulu.w  #CORK_STRIDE,d4         ; d4.l = sprite_y * 168
00:000AF106 243AF864        	   712:         move.l  STE_VIEW_BASE(pc),d2
00:000AF10A D882            	   713:         add.l   d2,d4                   ; d4.l = spr_addr in STE_CORK_BUF
                            	   714: .wb_poll:
00:000AF10C 7E00            	   715:         moveq   #0,d7
00:000AF10E 1E388205        	   716:         move.b  $ffff8205.w,d7
00:000AF112 4847            	   717:         swap    d7
00:000AF114 1E388207        	   718:         move.b  $ffff8207.w,d7
00:000AF118 E14F            	   719:         lsl.w   #8,d7
00:000AF11A 1E388209        	   720:         move.b  $ffff8209.w,d7
00:000AF11E 3F07            	   721:         move.w  d7,-(sp)
00:000AF120 E04F            	   722:         lsr.w   #8,d7
00:000AF122 BE388207        	   723:         cmp.b   $ffff8207.w,d7
00:000AF126 6624            	   724:         bne.s   .wb_retry
00:000AF128 3E1F            	   725:         move.w  (sp)+,d7
00:000AF12A 9E82            	   726:         sub.l   d2,d7                   ; d7 = beam_off (bytes from STE_VIEW_BASE)
00:000AF12C 6F22            	   727:         ble.s   .wb_ok                  ; top border -> ZERO WAIT!
00:000AF12E 0C8700008340    	   728:         cmpi.l  #(200*CORK_STRIDE),d7
00:000AF134 6C1A            	   729:         bge.s   .wb_ok                  ; bottom border -> ZERO WAIT!
00:000AF136 DE82            	   730:         add.l   d2,d7
00:000AF138 9E84            	   731:         sub.l   d4,d7                   ; d7 = beam_addr - spr_addr
00:000AF13A 0C87FFFFF580    	   732:         cmpi.l  #(-16*CORK_STRIDE),d7
00:000AF140 6D0E            	   733:         blt.s   .wb_ok                  ; beam > 16 lines ABOVE sprite -> ZERO WAIT!
00:000AF142 0C8700000BD0    	   734:         cmpi.l  #(18*CORK_STRIDE),d7
00:000AF148 6E06            	   735:         bgt.s   .wb_ok                  ; beam > 18 lines BELOW sprite -> ZERO WAIT!
00:000AF14A 60C0            	   736:         bra.s   .wb_poll                ; beam is right on this sprite -> wait ~0.6 ms!
                            	   737: .wb_retry:
00:000AF14C 548F            	   738:         addq.l  #2,sp
00:000AF14E 60BC            	   739:         bra.s   .wb_poll
                            	   740: .wb_ok:
00:000AF150 4CDF0094        	   741:         movem.l (sp)+,d2/d4/d7
00:000AF154 4E75            	   742:         rts

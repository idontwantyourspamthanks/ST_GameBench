00: "org0001:20000" (20000-202F8)


Source: "/home/ryan/Code/AtariST/gamebench/games/in_progress/moonshine-racers/work/lotus/bench/lbs2.s"
                            	     1: ; Lotus-style blitter sprite microbenchmark (own code; models what $c6f2c..$c7402 of the exemplar does, parameters take
                            	     2: ; the exemplar's own `info blitter` trace): mask word + P plane words interleaved per source word (stride 2*(P+1)), 4 A
                            	     3: ; (HOP=2 LOP=1, src = mask) + P OR passes (LOP=7, src = plane), HOG ($c0), fixed ~8-word blits ("rows per blit" k = max
                            	     4: ; from an unrolled pair chain `move.w d1,(a2) / move.b d6,(a6)` (a2 = ycount, a6 = control); registers persist between 
                            	     5: ; Case table at $30000: n.w, then n * (cols.w rows.w x.w np.w reps.w pad.w).  Markers m_case / m_end (cycle counter tim
                            	     6: BL      equ     $ffff8a00
                            	     7: SCR     equ     $50000
                            	     8: DAT     equ     $40000
                            	     9: CASES   equ     $30000
                            	    10:         org     $20000

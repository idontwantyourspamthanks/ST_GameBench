                            	     1: ; trkhook.s -- SCRATCH PROTOTYPE of the stage-2 hooks (MSRLoaderStudy).  Not product code: installed by hook_test.py th
                            	     2: ;   site A  $72c4  `jsr $76f4.l` (4eb9 000076f4)  -> `jsr hookA.l`        wraps the WHOLE race (setup + loop run inside
                            	     3: ;   site B  $77da  `lea.l $58c00.l,a0 / jsr $d6fa.l` (41f900058c00 4eb90000d6fa, 12 B) -> `jmp hookB.l` + 3 nops   trac
                            	     4: ; A swaps the campaign position into base-level terms for the duration of the race: $102c := base[pos] (every per-level
                            	     5: ; level), the position is kept in V_POS, and on return $102c := pos | (flags the race set: $80 time-out retry, $8000 ga
                            	     6: ; B copies the campaign entry's block into $58c00 (<= 6144 B, the stock capacity) instead of loading the stock block; a
                            	     7: ; Store layout (scratch format): +0 'MSTK'; +4 count.w; +6 pad; entry i at +8+8*i: base.b flag.b(1 = custom block) off.
                            	     8: STORE   equ     $110000
                            	     9: V_ACT   equ     $100f00         ; byte: 1 = a campaign is active (set by whoever loaded the store)
                            	    10: V_POS   equ     $100f02         ; word: campaign position
                            	    11: SIGOK   equ     $c0008          ; rd_geom standing-frame reuse flag (patches/rd_geom.s)

00:000AF0B8 3407            	   673:         move.w  d7,d2                   ; d2 = ty_row
00:000AF0BA 7008            	   674:         moveq   #8,d0                   ; cmd 8 = blit_row(d1=tx_left, d2=ty_row)
00:000AF0BC 4E48            	   675:         trap    #8

# --- Never commit copyrighted material -------------------------------------
# Users supply their own legal copies of the games and of TOS.

# TOS ROM images (Atari copyright). EmuTOS is GPL but kept out for simplicity.
tos/*
!tos/README.md

# Game files: PP's HAGA conversions (RUNME.TOS, HAGA, disk images, intro art), originals, archives
games/*/*/RUNME.TOS
games/*/*/HAGA
games/*/*/FILES/
games/*/*/*.HST
games/*/*/*.FIC
games/*/*/*.PCH
games/*/*/*.BMP
games/*/*/*.SWR
games/*/*/*.TXT
games/*/*/*.PRG
games/*/*/*.ST
games/*/*/*.st
games/*/*/*.zip
# Third-party game not part of this project
games/queue/steve-outrun-local/

# Floppy images and files extracted from them (per-game intake)
games/*/*/disks/
games/*/*/extracted/

# Anything containing game RAM, game data or game imagery
**/work/snapshots/
**/work/dumps/
**/work/disk_overlay/
**/work/ref/
**/work/manual*
**/work/guide*
**/work/**/*.png
**/work/**/*.bin
**/work/**/*.sav
**/work/**/*.st
**/*.png
**/*.sav
# Build outputs contain patched game files
**/build/
games/**/dist/
/dist/*
!/dist/*.sh

# --- Local / generated ------------------------------------------------------
__pycache__/
*.pyc
.venv/
games/*/*/tos/
**/*.img
**/*.gz
**/*.tos
**/*.TOS
**/*.hlog
# Machine-local helpers (e.g. writing to a personal disk image)
**/local_*
# Other versions of a game (other platforms/releases; user-supplied, copyrighted)
games/*/*/alt/
*.adf
*.ADF
*.ipf
*.dms
# Hard-disk driver files (commercial; user-supplied)
hd/*
!hd/README.md
a.out
# Manuals and scans (copyrighted)
**/*.pdf
**/*.PDF
**/*.wav
**/*.WAV
**/work/snd/
# Status reports for the user (local, not part of the repo)
reports/
# Raw screen/RAM captures (contain game imagery)
**/*.scr
**/*.base
**/*.pi1
**/*.neo
# Pickled traces / raw dumps (may contain game RAM)
**/*.pkl
**/*.npy
**/*.npz
**/*.raw

# Queued games awaiting work (copyrighted)
games/**/originals/
# Floppy images anywhere (copyrighted)
**/*.st
**/*.ST
**/*.msa
**/*.MSA
**/*.stx
**/*.STX

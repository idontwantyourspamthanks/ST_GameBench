Sections:
00: "org0001:ae940" (AE940-B02E6)


Source: "patches/ko2_ste.s"
                            	     1: ; ---------------------------------------------------------------------------
                            	     2: ; Player Manager v1.1 — Atari STE Amiga Audio & Visuals Engine (KO2STE.BIN)
                            	     3: ;
                            	     4: ; Loaded at $0ae940..$0affff (5.7 KB, cleanly above KO2_FILES_CR $09d000..$0ae940)
                            	     5: ; ONLY activated on Atari STE / Mega STE (when BR_IS_STE == 1).
                            	     6: ; Plain 68000 ST never calls this and runs 100% classic v1.0 ST mode.
                            	     7: ;
                            	     8: ; 1 MB STE RAM Layout during live match (after KRD finishes loading!):
                            	     9: ;   $081000..$08101f : STE 12-bit Amiga pitch palette (colours 0..7)
                            	    10: ;   $081020..$082e1f : 80x96 Amiga pitch tilemap (7,680 bytes, 0-based)
                            	    11: ;   $082e20..$088e1f : 256 x (16x16x3bpp) ST-interleaved tiles (24,576 bytes)
                            	    12: ;   $088f00..$09afff : STE Corkscrew scrolling buffer (424 x 168 = 71.2 KB)
                            	    13: ;   $09b000..$09cfff : Blitter 4bpp sprite save-under slots (32 x 256 = 8 KB)
                            	    14: ;
                            	    15: ; Entry points (fixed header at $0ae940):
                            	    16: ;   +$00 : bra.w ste_install_hooks  (after KO2ENG.BIN loads, before $01fd92)
                            	    17: ;   +$04 : bra.w ste_cleanup        (in Supervisor SR=$2700 on KO2 exit)
                            	    18: ;   +$08 : STE_SND_SIZE.l           (filled by ko2_bridge.s with AMIGASND.BIN size)
                            	    19: ;   +$0c : bra.w ste_load_pitch     (after $013450, loads AMIGAP0..3.BIN -> $081000)
                            	    20: ; ---------------------------------------------------------------------------
                            	    21: 
                            	    22:         org     $0ae940
                            	    23: 
                            	    24: KO2_A4          equ     $0284aa
                            	    25: BR_TOS_84       equ     $0b5814         ; saved original TOS TRAP #1 vector
                            	    26: STE_SND_STG     equ     $0c8b00         ; AMIGASND.BIN staging in KO2_REPLAY_BUF
                            	    27: 
                            	    28: STE_PIT_PAL     equ     $081000         ; 32 bytes (8 STE 12-bit pitch colours)
                            	    29: STE_PIT_MAP     equ     $081020         ; 7,680 bytes (80 x 96 tilemap)
                            	    30: STE_PIT_TILES   equ     $082e20         ; 24,576 bytes (256 x 96 bytes)
                            	    31: STE_CORK_BUF    equ     $088f00         ; 73,984 bytes (424 x 168 + 480 slack)
                            	    32: STE_SAVE_UNDER  equ     $09b000         ; 8,192 bytes (32 x 256 byte save-under slots)
                            	    33: ; STE Blitter HUD/Radar save-under & 1bpp mask buffers (100% inside 1 MB RAM!):
                            	    34: STE_HUD_MASK    equ     $07fd00         ; 320 bytes (1bpp HUD/Banner mask & 32B sprite mask)
                            	    35: STE_MASK_BUF    equ     $07fd00         ; 32 bytes (16-line 1bpp sprite mask scratch)
                            	    36: STE_RADAR_SAVE  equ     $07fe40         ; 4,536 bytes: Blitter radar line save-under pool!
                            	    37: STE_RAD_POOL    equ     $07fe40         ; line pixel save pool ($07fe40..$080ff8 = 4,536B = 567 cells -> fits scale=8!)
                            	    38: STE_RAD_POOL_END equ    $080ff8
                            	    39: STE_RAD_LREC    equ     $09a700         ; line restore records (max 24 x 12B = 288B -> $09a820, free gap > CORK $09a678
                            	    40: STE_RAD_DREC    equ     $09a820         ; dot restore records (max 56 x 12B = 672B -> $09aac0 < SAVE_UNDER $09b000)
                            	    41: STE_BHUD_SAVE   equ     $0b2400         ; 1,128 bytes (tight 3-box Bottom HUD) -> $0b2868
                            	    42: STE_DRAW_STACK  equ     $0b2880         ; 512 bytes (32 x 16B overlap-safe LIFO sprite stack!) -> $0b2a80
                            	    43: STE_BAN_SAVE    equ     $0b2a80         ; 1,344 bytes (8 lines x 21 cols x 8B) -> $0b2fc0 (< PMOK $0b2ff8!)
                            	    44: 
                            	    45: CORK_STRIDE     equ     168             ; 336 pixels = 21 x 16px words (4 planes)
                            	    46: CORK_RING_H     equ     224             ; 14 tile rows = 224 scanlines
                            	    47: CORK_RING_BYTES equ     37632           ; 224 * 168
                            	    48: 
                            	    49: ; STE Blitter registers (short I/O addresses $ffff8a20..$ffff8a3d -> 4-byte .w saves 300B + cycles!)
                            	    50: BLT_SRC_XINC    equ     $ffff8a20
                            	    51: BLT_SRC_YINC    equ     $ffff8a22
                            	    52: BLT_SRC_ADDR    equ     $ffff8a24
                            	    53: BLT_ENDMASK1    equ     $ffff8a28
                            	    54: BLT_ENDMASK2    equ     $ffff8a2a
                            	    55: BLT_ENDMASK3    equ     $ffff8a2c
                            	    56: BLT_DST_XINC    equ     $ffff8a2e
                            	    57: BLT_DST_YINC    equ     $ffff8a30
                            	    58: BLT_DST_ADDR    equ     $ffff8a32
                            	    59: BLT_XCOUNT      equ     $ffff8a36
                            	    60: BLT_YCOUNT      equ     $ffff8a38
                            	    61: BLT_HOP         equ     $ffff8a3a
                            	    62: BLT_OP          equ     $ffff8a3b
                            	    63: BLT_LINE        equ     $ffff8a3c
                            	    64: BLT_SKEW        equ     $ffff8a3d
                            	    65: 
                            	    66: ; Jump table & header at $0ae940
                            	    67: ste_entry:
00:000AE940 60000050        	    68:         bra.w   ste_install_hooks       ; +$00
00:000AE944 600001B6        	    69:         bra.w   ste_cleanup             ; +$04
00:000AE948 00000000        	    70: STE_SND_SIZE:   dc.l    0               ; +$08 (set by ko2_bridge.s)
00:000AE94C 600001F0        	    71:         bra.w   ste_load_pitch          ; +$0c
                            	    72: 
                            	    73: ; ---------------------------------------------------------------------------
                            	    74: ; Audio State variables
                            	    75: ; ---------------------------------------------------------------------------
00:000AE950 00000000        	    76: STE_SND_BASE:   dc.l    0               ; +$10: base of AMIGASND.BIN in KO2 heap
00:000AE954 00000000        	    77: STE_SCRIPT_ST:  dc.l    0               ; start of current sound script
00:000AE958 00000000        	    78: STE_SCRIPT_PTR: dc.l    0               ; current pointer in sound script (0 = idle)
00:000AE95C 0000            	    79: STE_REPEAT_CNT: dc.w    0               ; repeat counter
00:000AE95E 00              	    80: STE_SND_PEND:   dc.b    0               ; 1 = new sound requested
00:000AE95F 00              	    81: STE_SND_STOP:   dc.b    0               ; 1 = stop DMA requested
00:000AE960 00              	    82: STE_SND_PITCH:  dc.b    0
00:000AE961 00              	    83: STE_SND_PAD:    dc.b    0
00:000AE962 0000            	    84: STE_DMA_CNT:    dc.w    0               ; total STE DMA samples triggered
                            	    85: 
                            	    86: ; ---------------------------------------------------------------------------
                            	    87: ; Video / Corkscrew / Blitter State variables
                            	    88: ; ---------------------------------------------------------------------------
00:000AE964 0000            	    89: STE_AMIGA_ON:   dc.w    0               ; 1 = Amiga STE Tiled Pitch ON, 0 = Classic ST
00:000AE966 0000            	    90: STE_PITCH_OK:   dc.w    0               ; 1 = AMIGAPx.BIN loaded successfully
00:000AE968 FC19            	    91: STE_CUR_TX:     dc.w    -999            ; last top-left tile X in Corkscrew
00:000AE96A FC19            	    92: STE_CUR_TY:     dc.w    -999            ; last top-left tile Y in Corkscrew
00:000AE96C 00088F00        	    93: STE_VIEW_BASE:  dc.l    STE_CORK_BUF    ; current display address for VBL
00:000AE970 0000            	    94: STE_VIEW_HSCR:  dc.w    0               ; current STE fine hscroll (0..15)
00:000AE972 0000            	    95: STE_SLOT_NEXT:  dc.w    0               ; next free save-under slot (0..31)
00:000AE974 0000            	    96: STE_ST_PAL:     ds.w    8               ; saved Classic ST palette 0..7
00:000AE976 *
00:000AE984 0000            	    97: STE_ST_PAL_OK:  dc.w    0               ; 1 = saved ST palette captured
00:000AE986 0000            	    98: STE_HUD_ACTIVE: dc.w    0               ; bit0=bhud saved, bit1=banner saved
00:000AE988 00000000        	    99: STE_HUD_VBASE:  dc.l    0               ; STE_VIEW_BASE where HUD/Radar was drawn
00:000AE98C 0000            	   100: STE_RAD_LCNT:   dc.w    0               ; active Blitter radar line records (0..24)
00:000AE98E 0000            	   101: STE_RAD_DCNT:   dc.w    0               ; active radar dot records (0..56)
00:000AE990 0000            	   102: STE_DRAW_CNT:   dc.w    0               ; number of sprites on LIFO draw stack (0..32)
                            	   103: 
                            	   104: ; ---------------------------------------------------------------------------
                            	   105: ; ste_install_hooks: Patch KO2ENG.BIN at $010000..$024000 for STE hardware
                            	   106: ; ---------------------------------------------------------------------------
                            	   107: ste_install_hooks:
00:000AE992 42B9000AE950    	   108:         clr.l   STE_SND_BASE
00:000AE998 42B9000AE954    	   109:         clr.l   STE_SCRIPT_ST
00:000AE99E 42B9000AE958    	   110:         clr.l   STE_SCRIPT_PTR
00:000AE9A4 4279000AE95C    	   111:         clr.w   STE_REPEAT_CNT
00:000AE9AA 4239000AE95E    	   112:         clr.b   STE_SND_PEND
00:000AE9B0 4239000AE95F    	   113:         clr.b   STE_SND_STOP
00:000AE9B6 4279000AE962    	   114:         clr.w   STE_DMA_CNT
00:000AE9BC 4279000AE964    	   115:         clr.w   STE_AMIGA_ON
00:000AE9C2 4279000AE966    	   116:         clr.w   STE_PITCH_OK
00:000AE9C8 4279000AE984    	   117:         clr.w   STE_ST_PAL_OK
00:000AE9CE 4279000AE986    	   118:         clr.w   STE_HUD_ACTIVE
00:000AE9D4 4279000AE98C    	   119:         clr.w   STE_RAD_LCNT
00:000AE9DA 4279000AE98E    	   120:         clr.w   STE_RAD_DCNT
00:000AE9E0 4279000AE990    	   121:         clr.w   STE_DRAW_CNT
00:000AE9E6 4279000AE972    	   122:         clr.w   STE_SLOT_NEXT
00:000AE9EC 33FCFC19000AE968	   123:         move.w  #-999,STE_CUR_TX
00:000AE9F4 33FCFC19000AE96A	   124:         move.w  #-999,STE_CUR_TY
00:000AE9FC 23FC00088F00000A	   125:         move.l  #STE_CORK_BUF,STE_VIEW_BASE
00:000AEA04 E96C
00:000AEA06 4279000AE970    	   126:         clr.w   STE_VIEW_HSCR
                            	   127: 
                            	   128:         ; Install TRAP #8 ($a0.w) fast Supervisor Blitter dispatcher via Supexec
00:000AEA0C 487A00E4        	   129:         pea     ste_inst_trap8(pc)
00:000AEA10 3F3C0026        	   130:         move.w  #$26,-(sp)
00:000AEA14 4E4E            	   131:         trap    #14
00:000AEA16 5C8F            	   132:         addq.l  #6,sp
                            	   133: 
                            	   134:         ; 1. Audio hooks ($01849e load, $0184fe play low, $018506 play hi, $018598 stop)
00:000AEA18 33FC4EF90001849E	   135:         move.w  #$4ef9,$01849e.l
00:000AEA20 23FC000AEB980001	   136:         move.l  #ste_load_samples,$0184a0.l
00:000AEA28 84A0
00:000AEA2A 33FC4EF9000184FE	   137:         move.w  #$4ef9,$0184fe.l
00:000AEA32 23FC000AEBE00001	   138:         move.l  #ste_play_sound,$018500.l
00:000AEA3A 8500
00:000AEA3C 33FC4EF900018506	   139:         move.w  #$4ef9,$018506.l
00:000AEA44 23FC000AEBE60001	   140:         move.l  #ste_play_sound_hi,$018508.l
00:000AEA4C 8508
00:000AEA4E 33FC4EF900018598	   141:         move.w  #$4ef9,$018598.l
00:000AEA56 23FC000AEC1C0001	   142:         move.l  #ste_stop_sound,$01859a.l
00:000AEA5E 859A
                            	   143: 
                            	   144:         ; 2. VBL top ($018d06 Timer B setup) & bottom ($018e0a $ff8240 write + $018e22 end)
00:000AEA60 33FC4EF900018D06	   145:         move.w  #$4ef9,$018d06.l
00:000AEA68 23FC000AEC360001	   146:         move.l  #ste_vbl_top,$018d08.l
00:000AEA70 8D08
00:000AEA72 33FC4EF900018E0A	   147:         move.w  #$4ef9,$018e0a.l
00:000AEA7A 23FC000AED3A0001	   148:         move.l  #ste_vbl_end,$018e0c.l
00:000AEA82 8E0C
                            	   149: 
                            	   150:         ; 3. Pitch camera & lines ($01c1d0)
00:000AEA84 33FC4EF90001C1D0	   151:         move.w  #$4ef9,$01c1d0.l
00:000AEA8C 23FC000AEF0A0001	   152:         move.l  #ste_pitch_update,$01c1d2.l
00:000AEA94 C1D2
                            	   153: 
                            	   154:         ; 4. Universal sprite draw core ($01a426: mulu.w #$a0,d1 ; ext.l d0) & erase ($01a83e)
                            	   155:         ;    All 4 KO2 sprite entry points ($01a2fc, $01a346, $01a3bc, $01a412) funnel into $01a426!
00:000AEA96 33FC4EF90001A426	   156:         move.w  #$4ef9,$01a426.l
00:000AEA9E 23FC000AF1560001	   157:         move.l  #ste_draw_spr_core_hook,$01a428.l
00:000AEAA6 A428
00:000AEAA8 33FC4EF90001A83E	   158:         move.w  #$4ef9,$01a83e.l
00:000AEAB0 23FC000AF2400001	   159:         move.l  #ste_erase_spr,$01a840.l
00:000AEAB8 A840
                            	   160:         ; Also bypass KO2's Timer B raster-beam wait at $01a376 & $01a3cc when Amiga mode is ON!
00:000AEABA 33FC4EF90001A376	   161:         move.w  #$4ef9,$01a376.l
00:000AEAC2 23FC000AF0C40001	   162:         move.l  #ste_skip_beam_1,$01a378.l
00:000AEACA A378
00:000AEACC 33FC4EF90001A3CC	   163:         move.w  #$4ef9,$01a3cc.l
00:000AEAD4 23FC000AF0E00001	   164:         move.l  #ste_skip_beam_2,$01a3ce.l
00:000AEADC A3CE
                            	   165: 
                            	   166:         ; 5. In-match key handler ($01b564: cmpi.w #$72,d0 ; bne.b $1b570) -> 'V' view toggle!
00:000AEADE 33FC4EF90001B564	   167:         move.w  #$4ef9,$01b564.l
00:000AEAE6 23FC000AEE880001	   168:         move.l  #ste_key_hook,$01b566.l
00:000AEAEE B566
                            	   169: 
00:000AEAF0 4E75            	   170:         rts
                            	   171: 
                            	   172: ste_inst_trap8:
00:000AEAF2 21FC000AFA3600A0	   173:         move.l  #ste_trap8_handler,$a0.w
00:000AEAFA 4E75            	   174:         rts

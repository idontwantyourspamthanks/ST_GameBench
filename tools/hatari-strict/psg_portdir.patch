 static unsigned int LastStrobe=0; /* Falling edge of Strobe used for printer */
 
+/*
+ * gamebench "strict" patch: model the YM2149 I/O port direction (register 7 bit 6 = port A, bit 7 = port B; 1 = output).
+ * Stock Hatari keeps PSGRegisters[14] (floppy drive-select bits 1-2, side bit 0) whatever register 7 says. On a real
+ * ST/STE an input port A does not drive the pins, so the drive-select/side lines float high (all deselected) and
+ * a reg 14 write has no effect on the floppy. HATARI_PSG_LENIENT=1 in the environment restores stock behaviour.
+ */
+static int PSG_StrictPortDir = -1;
+static unsigned int PSG_StrictWarned;
 
+uint8_t PSG_GetPortAPins(void)
+{
+	if ( PSG_StrictPortDir < 0 )
+	{
+		const char *e = getenv ( "HATARI_PSG_LENIENT" );
+		PSG_StrictPortDir = ( e && *e && *e != '0' ) ? 0 : 1;
+	}
+	if ( PSG_StrictPortDir && ( PSGRegisters[PSG_REG_MIXER_CONTROL] & 0x40 ) == 0 )
+		return 0xff;				/* port A is an input: pins float high, no drive selected, side 0 */
+	return PSGRegisters[PSG_REG_IO_PORTA];
+}
+
+static void PSG_PortAPinsChanged ( uint8_t pins_old )
+{
+	uint8_t pins_new = PSG_GetPortAPins();
+
+	Statusbar_SetFloppyLed ( DRIVE_LED_A , ( pins_new & (1<<1) ) == 0 ? LED_STATE_ON : LED_STATE_OFF );
+	Statusbar_SetFloppyLed ( DRIVE_LED_B , ( pins_new & (1<<2) ) == 0 ? LED_STATE_ON : LED_STATE_OFF );
+	FDC_SetDriveSide ( pins_old & 7 , pins_new & 7 );
+}
+

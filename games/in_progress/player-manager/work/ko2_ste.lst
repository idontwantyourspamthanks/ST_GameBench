                            	   176: ; ---------------------------------------------------------------------------
                            	   177: ; ste_cleanup: Called in Supervisor mode (SR=$2700) when exiting KO2 back to PM
                            	   178: ; ---------------------------------------------------------------------------
                            	   179: ste_cleanup:
00:000AEAFC 423900FF8901    	   180:         clr.b   $00ff8901.l             ; stop STE DMA audio
00:000AEB02 423900FF820F    	   181:         clr.b   $00ff820f.l             ; reset STE line width (extra words = 0)
00:000AEB08 423900FF8265    	   182:         clr.b   $00ff8265.l             ; reset STE fine hscroll = 0
00:000AEB0E 13FC000700FF8201	   183:         move.b  #$07,$00ff8201.l        ; restore standard $078000 screen base
00:000AEB16 13FC008000FF8203	   184:         move.b  #$80,$00ff8203.l
00:000AEB1E 423900FF820D    	   185:         clr.b   $00ff820d.l
00:000AEB24 4279000AE964    	   186:         clr.w   STE_AMIGA_ON
00:000AEB2A 42B9000AE958    	   187:         clr.l   STE_SCRIPT_PTR
00:000AEB30 4239000AE95E    	   188:         clr.b   STE_SND_PEND
00:000AEB36 4239000AE95F    	   189:         clr.b   STE_SND_STOP
00:000AEB3C 4E75            	   190:         rts

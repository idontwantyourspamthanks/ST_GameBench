                            	   744: ste_draw_spr_core_hook:
00:000AF156 4A79000AE964    	   745:         tst.w   STE_AMIGA_ON
00:000AF15C 660C            	   746:         bne.s   .dsc_amiga
                            	   747:         ; Classic ST Mode: run original $01a426 (mulu.w #$a0,d1 ; ext.l d0)
00:000AF15E C2FC00A0        	   748:         mulu.w  #$a0,d1
00:000AF162 48C0            	   749:         ext.l   d0
00:000AF164 4EF90001A42C    	   750:         jmp     $01a42c.l
                            	   751: 
                            	   752: .dsc_amiga:
00:000AF16A 48E71020        	   753:         movem.l d3/a2,-(sp)             ; preserve d3 & a2 (caller's entity struct ptr!)
00:000AF16E 610A            	   754:         bsr.s   ste_blit_spr_core
00:000AF170 4CDF0408        	   755:         movem.l (sp)+,d3/a2
00:000AF174 4CDF0B97        	   756:         movem.l (sp)+,d0-d2/d4/d7/a0-a1/a3
00:000AF178 4E75            	   757:         rts
                            	   758: 
                            	   759: ; Core Amiga STE 4bpp masked sprite draw: d0=x, d1=y, a1=3bpp src, a3=KO2 save record
                            	   760: ste_blit_spr_core:
                            	   761:         ; 1. Get or allocate persistent 256-byte save-under slot for a3
00:000AF17A 0C6B53540008    	   762:         cmpi.w  #$5354,8(a3)            ; magic "ST" already assigned?
00:000AF180 6726            	   763:         beq.s   .have_slot
00:000AF182 343AF7EE        	   764:         move.w  STE_SLOT_NEXT(pc),d2
00:000AF186 0C420020        	   765:         cmpi.w  #32,d2
00:000AF18A 640000B2        	   766:         bcc.w   .spr_ret                ; safety cap (32 slots)
00:000AF18E 5279000AE972    	   767:         addq.w  #1,STE_SLOT_NEXT
                            	   768:         ; Slot address = STE_SAVE_UNDER + d2 * 256
00:000AF194 E14A            	   769:         lsl.w   #8,d2
00:000AF196 48C2            	   770:         ext.l   d2
00:000AF198 06820009B000    	   771:         addi.l  #STE_SAVE_UNDER,d2
00:000AF19E 27420004        	   772:         move.l  d2,4(a3)
00:000AF1A2 377C53540008    	   773:         move.w  #$5354,8(a3)
                            	   774: .have_slot:
                            	   775:         ; 2. Compute dst inside STE_VIEW_BASE:
                            	   776:         ;    x_in_view = d0 + STE_VIEW_HSCR
                            	   777:         ;    dst = STE_VIEW_BASE + d1 * 168 + (x_in_view >> 4) * 8
                            	   778:         ;    skew = x_in_view & 15
00:000AF1A8 D07AF7C6        	   779:         add.w   STE_VIEW_HSCR(pc),d0
00:000AF1AC 3400            	   780:         move.w  d0,d2
00:000AF1AE 0242000F        	   781:         andi.w  #15,d2                  ; d2 = skew (0..15)
00:000AF1B2 E848            	   782:         lsr.w   #4,d0
00:000AF1B4 E748            	   783:         lsl.w   #3,d0                   ; word_col * 8
00:000AF1B6 C2FC00A8        	   784:         mulu.w  #CORK_STRIDE,d1         ; y * 168
00:000AF1BA 48C0            	   785:         ext.l   d0
00:000AF1BC D280            	   786:         add.l   d0,d1
00:000AF1BE D2BAF7AC        	   787:         add.l   STE_VIEW_BASE(pc),d1
00:000AF1C2 2041            	   788:         movea.l d1,a0                   ; a0 = dst in STE_CORK_BUF
00:000AF1C4 2688            	   789:         move.l  a0,(a3)                 ; save dst addr in 0(a3)
                            	   790: 
                            	   791:         ; 3. Build 16-word 1bpp mask in STE_MASK_BUF (32 bytes, direct from a1!)
                            	   792:         ;    KO2 3bpp sprite layout: row y has p0 at (a1), p1 at $28(a1), p2 at $50(a1), stride $78!
00:000AF1C6 2449            	   793:         movea.l a1,a2                   ; save sprite src ptr in a2
00:000AF1C8 48E70AC0        	   794:         movem.l d4/d6/a0-a1,-(sp)
00:000AF1CC 41F90007FD00    	   795:         lea     STE_MASK_BUF.l,a0
00:000AF1D2 7C0F            	   796:         moveq   #15,d6
                            	   797: .mk_lp:
00:000AF1D4 3811            	   798:         move.w  (a1),d4
00:000AF1D6 88690028        	   799:         or.w    $28(a1),d4
00:000AF1DA 88690050        	   800:         or.w    $50(a1),d4
00:000AF1DE 30C4            	   801:         move.w  d4,(a0)+
00:000AF1E0 43E90078        	   802:         lea     $78(a1),a1
00:000AF1E4 51CEFFEE        	   803:         dbra    d6,.mk_lp
00:000AF1E8 4CDF0350        	   804:         movem.l (sp)+,d4/d6/a0-a1
                            	   805: 
                            	   806:         ; 4. Combined Save-under + Direct NFSR 4bpp Masked Blitter Draw in ONE TRAP #8!
                            	   807:         ;    Push 16-byte record: +0=a3.l, +4=dst.l, +8=src.l, +12=skew.b, +13=slot.b, +14=x_col.b, +15=y_px.b
                            	   808:         ;    (d0.l currently holds x_col*8, d1.w was multiplied by 168 — recover x_col & y_px cleanly!)
00:000AF1EC 246B0004        	   809:         movea.l 4(a3),a2                ; a2 = save-under slot
00:000AF1F0 363AF79E        	   810:         move.w  STE_DRAW_CNT(pc),d3
00:000AF1F4 0C430020        	   811:         cmpi.w  #32,d3
00:000AF1F8 643E            	   812:         bcc.s   .no_push
00:000AF1FA 5279000AE990    	   813:         addq.w  #1,STE_DRAW_CNT
00:000AF200 E94B            	   814:         lsl.w   #4,d3                   ; index * 16
00:000AF202 48E7C010        	   815:         movem.l d0-d1/a3,-(sp)
00:000AF206 47F9000B2880    	   816:         lea     STE_DRAW_STACK.l,a3
00:000AF20C D6C3            	   817:         adda.w  d3,a3
00:000AF20E 26EF0008        	   818:         move.l  8(sp),(a3)+             ; +0: KO2 a3 ptr
00:000AF212 26C8            	   819:         move.l  a0,(a3)+                ; +4: dst in STE_CORK_BUF
00:000AF214 26C9            	   820:         move.l  a1,(a3)+                ; +8: src (KO2 3bpp sprite)
00:000AF216 16C2            	   821:         move.b  d2,(a3)+                ; +12: skew (0..15)
00:000AF218 260A            	   822:         move.l  a2,d3
00:000AF21A 04830009B000    	   823:         subi.l  #STE_SAVE_UNDER,d3
00:000AF220 E04B            	   824:         lsr.w   #8,d3
00:000AF222 16C3            	   825:         move.b  d3,(a3)+                ; +13: slot_idx (0..31)
00:000AF224 E648            	   826:         lsr.w   #3,d0
00:000AF226 16C0            	   827:         move.b  d0,(a3)+                ; +14: x_col (0..20)
00:000AF228 2208            	   828:         move.l  a0,d1
00:000AF22A 92BAF740        	   829:         sub.l   STE_VIEW_BASE(pc),d1
00:000AF22E 82FC00A8        	   830:         divu.w  #CORK_STRIDE,d1         ; d1.w = y_px (0..199)
00:000AF232 1681            	   831:         move.b  d1,(a3)                 ; +15: y_px (0..199)
00:000AF234 4CDF0803        	   832:         movem.l (sp)+,d0-d1/a3
                            	   833: .no_push:
00:000AF238 3202            	   834:         move.w  d2,d1                   ; d1 = skew (0..15)
00:000AF23A 7003            	   835:         moveq   #3,d0                   ; cmd 3 = save_and_draw_sprite
00:000AF23C 4E48            	   836:         trap    #8
                            	   837: .spr_ret:
00:000AF23E 4E75            	   838:         rts
                            	   839: 
                            	   840: ; Erase sprite ($01a83e)
                            	   841: ste_erase_spr:
00:000AF240 4A79000AE964    	   842:         tst.w   STE_AMIGA_ON
00:000AF246 6610            	   843:         bne.s   ste_erase_spr_amiga
                            	   844:         ; Classic ST Mode: run original $01a83e..
00:000AF248 4A93            	   845:         tst.l   (a3)
00:000AF24A 6706            	   846:         beq.s   .es_st_z
00:000AF24C 4EF90001A844    	   847:         jmp     $01a844.l
                            	   848: .es_st_z:
00:000AF252 4EF90001AAAA    	   849:         jmp     $01aaaa.l
                            	   850: 
                            	   851: ; Overlap-safe LIFO sprite erase for KO2 record a3:
                            	   852: ; - If no sprite drawn AFTER a3 is within +-2688 bytes (16 scanlines): fast 1-blit restore!
                            	   853: ; - If any sprite above a3 overlaps it (kickoff walk-out, tackles): LIFO restore from top
                            	   854: ;   down to a3, remove a3, and re-draw the sprites that were above a3 -> ZERO GHOSTS!
                            	   855: ste_erase_spr_amiga:

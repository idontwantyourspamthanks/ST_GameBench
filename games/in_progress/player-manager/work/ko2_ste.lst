                            	   192: ; ---------------------------------------------------------------------------
                            	   193: ; ste_load_pitch (ste_init_pitch): Called after ko2_bridge.s loads AMIGAPx.BIN
                            	   194: ; into $081000..$088e1f. Input: d0.l = bytes read (32288 = success).
                            	   195: ; ---------------------------------------------------------------------------
                            	   196: ste_load_pitch:
00:000AEB3E 0C8000007E20    	   197:         cmpi.l  #32288,d0
00:000AEB44 6644            	   198:         bne.s   .lp_fail
00:000AEB46 33FC0001000AE966	   199:         move.w  #1,STE_PITCH_OK
00:000AEB4E 33FC0001000AE964	   200:         move.w  #1,STE_AMIGA_ON
00:000AEB56 4279000AE972    	   201:         clr.w   STE_SLOT_NEXT
00:000AEB5C 4279000AE990    	   202:         clr.w   STE_DRAW_CNT
00:000AEB62 4279000AE98C    	   203:         clr.w   STE_RAD_LCNT
00:000AEB68 4279000AE98E    	   204:         clr.w   STE_RAD_DCNT
00:000AEB6E 4279000AE986    	   205:         clr.w   STE_HUD_ACTIVE
00:000AEB74 33FCFC19000AE968	   206:         move.w  #-999,STE_CUR_TX
00:000AEB7C 33FCFC19000AE96A	   207:         move.w  #-999,STE_CUR_TY
00:000AEB84 7004            	   208:         moveq   #4,d0                   ; cmd 4 = clear_cork via STE Blitter!
00:000AEB86 4E48            	   209:         trap    #8
00:000AEB88 4E75            	   210:         rts
                            	   211: .lp_fail:
00:000AEB8A 4279000AE966    	   212:         clr.w   STE_PITCH_OK
00:000AEB90 4279000AE964    	   213:         clr.w   STE_AMIGA_ON
00:000AEB96 4E75            	   214:         rts
                            	   215: 
                            	   216: ; ---------------------------------------------------------------------------
                            	   217: ; Audio: ste_load_samples / ste_play_sound / ste_play_sound_hi / ste_stop_sound
                            	   218: ; ---------------------------------------------------------------------------
                            	   219: ste_load_samples:
00:000AEB98 48E78080        	   220:         movem.l d0/a0,-(sp)
00:000AEB9C 203AFDAA        	   221:         move.l  STE_SND_SIZE(pc),d0
00:000AEBA0 6F2E            	   222:         ble.s   .ls_none
00:000AEBA2 200D            	   223:         move.l  a5,d0
00:000AEBA4 5280            	   224:         addq.l  #1,d0
00:000AEBA6 C0BCFFFFFFFE    	   225:         and.l   #$fffffffe,d0
00:000AEBAC 2A40            	   226:         movea.l d0,a5
00:000AEBAE 294DEBAE        	   227:         move.l  a5,-$1452(a4)
00:000AEBB2 23CD000AE950    	   228:         move.l  a5,STE_SND_BASE
00:000AEBB8 41F9000C8B00    	   229:         lea     STE_SND_STG.l,a0
00:000AEBBE 203AFD88        	   230:         move.l  STE_SND_SIZE(pc),d0
00:000AEBC2 5680            	   231:         addq.l  #3,d0
00:000AEBC4 E488            	   232:         lsr.l   #2,d0
00:000AEBC6 5340            	   233:         subq.w  #1,d0
00:000AEBC8 2AD8            	   234: .cp_s:  move.l  (a0)+,(a5)+
00:000AEBCA 51C8FFFC        	   235:         dbra    d0,.cp_s
00:000AEBCE 6006            	   236:         bra.s   .ls_done
                            	   237: .ls_none:
00:000AEBD0 42B9000AE950    	   238:         clr.l   STE_SND_BASE
                            	   239: .ls_done:
00:000AEBD6 426CEBD6        	   240:         clr.w   -$142a(a4)
00:000AEBDA 4CDF0101        	   241:         movem.l (sp)+,d0/a0
00:000AEBDE 4E75            	   242:         rts

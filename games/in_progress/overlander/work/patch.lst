                            	   397: ; ============================================================================
                            	   398: ; do_road_blitter — STE Blitter replacement for sub_017826 (+0xcd8c)
                            	   399: ; Input: d0.w = y_start (draws scanlines y_start .. 127)
                            	   400: ; ============================================================================
                            	   401: do_road_blitter:
00:00000372 4DFAFCEC        	   402:     lea     has_blitter(pc),a6
00:00000376 4A16            	   403:     tst.b   (a6)
00:00000378 660C            	   404:     bne.s   .road_blt
                            	   405:     ; Plain ST / TT fallback: run original CPU road renderer
00:0000037A 3F3C0080        	   406:     move.w  #$80,-(sp)
00:0000037E 9157            	   407:     sub.w   d0,(sp)
00:00000380 207AFCCA        	   408:     movea.l ptr_orig_road_cont(pc),a0
00:00000384 4ED0            	   409:     jmp     (a0)
                            	   410: 
                            	   411: .road_blt:
00:00000386 3E3C0080        	   412:     move.w  #$80,d7
00:0000038A 9E40            	   413:     sub.w   d0,d7                       ; d7 = line count (128 - y_start)
00:0000038C 6F00016E        	   414:     ble.w   .road_rts
                            	   415: 
                            	   416:     ; Compute a0 = road_table + y_start * 8, a2 = screen_ptrs[y_start]
00:00000390 207AFCAE        	   417:     movea.l ptr_lowram_bss(pc),a0
00:00000394 41E847DA        	   418:     adda.l  #($4fda-$0800),a0           ; road table base ($4fda)
00:00000398 227AFC96        	   419:     movea.l ptr_game_base(pc),a1
00:0000039C 2469000E        	   420:     movea.l $0e(a1),a2                  ; *$aaa8 -> scanline ptr table
00:000003A0 3200            	   421:     move.w  d0,d1
00:000003A2 E541            	   422:     asl.w   #2,d1
00:000003A4 24721000        	   423:     movea.l (a2,d1.w),a2                ; a2 = screen addr at y_start
00:000003A8 D241            	   424:     add.w   d1,d1                       ; d1 = y_start * 8
00:000003AA D0C1            	   425:     adda.w  d1,a0                       ; a0 = &road_table[y_start]
                            	   426: 
                            	   427:     ; Step 1: Fill entire road area (d7 lines) with Grass color 7 in 8-line HOG chunks
00:000003AC 4DF88A00        	   428:     lea     $ffff8a00.w,a6
00:000003B0 3D7CFFFF0028    	   429:     move.w  #$ffff,BLT_ENDMASK1(a6)
00:000003B6 3D7CFFFF002A    	   430:     move.w  #$ffff,BLT_ENDMASK2(a6)
00:000003BC 3D7CFFFF002C    	   431:     move.w  #$ffff,BLT_ENDMASK3(a6)
00:000003C2 422E003D        	   432:     clr.b   BLT_SKEW(a6)
00:000003C6 422E003A        	   433:     clr.b   BLT_HOP(a6)
00:000003CA 2F08            	   434:     move.l  a0,-(sp)
00:000003CC 204A            	   435:     movea.l a2,a0
00:000003CE 6100FEAA        	   436:     bsr.w   blt_fill_color7_hog
00:000003D2 205F            	   437:     movea.l (sp)+,a0
                            	   438: 
                            	   439:     ; Step 2: Per-scanline Blitter span loop
                            	   440:     ; Constant Blitter regs already set: DST_XINC=8, DST_YINC=8, ENDMASK2=$ffff, HOP=0, SKEW=0
00:000003D4 49FAFF5C        	   441:     lea     road_left_mask(pc),a4
00:000003D8 4BFAFF78        	   442:     lea     road_right_mask(pc),a5
00:000003DC 5347            	   443:     subq.w  #1,d7                       ; dbra counter
                            	   444: 
                            	   445: .line_loop:
                            	   446:     ; Check grass band: bit 6 of color_off (6(a0)) -> 0 = Grass 7 (1110), 1 = Grass 11 (1101)
00:000003DE 3C280006        	   447:     move.w  6(a0),d6
00:000003E2 08060006        	   448:     btst    #6,d6
00:000003E6 670000BE        	   449:     beq.w   .grass_is_7
                            	   450: 
                            	   451:     ; Grass 11 (1101): flip P2 -> 0 and P3 -> 1 across full 20 words of this line
00:000003EA 3D7CFFFF0028    	   452:     move.w  #$ffff,BLT_ENDMASK1(a6)
00:000003F0 3D7CFFFF002C    	   453:     move.w  #$ffff,BLT_ENDMASK3(a6)
00:000003F6 43EA0004        	   454:     lea     4(a2),a1
00:000003FA 2D490032        	   455:     move.l  a1,BLT_DST_ADDR(a6)
00:000003FE 3D7C00140036    	   456:     move.w  #20,BLT_X_CNT(a6)
00:00000404 3D7C00010038    	   457:     move.w  #1,BLT_Y_CNT(a6)
00:0000040A 422E003B        	   458:     clr.b   BLT_OP(a6)
00:0000040E 1D7C00C0003C    	   459:     move.b  #$c0,BLT_CTRL(a6)           ; 1-line 20-word burst (~80 cyc)
                            	   460: 
00:00000414 5489            	   461:     addq.l  #2,a1
00:00000416 2D490032        	   462:     move.l  a1,BLT_DST_ADDR(a6)
00:0000041A 3D7C00140036    	   463:     move.w  #20,BLT_X_CNT(a6)
00:00000420 3D7C00010038    	   464:     move.w  #1,BLT_Y_CNT(a6)
00:00000426 1D7C000F003B    	   465:     move.b  #15,BLT_OP(a6)
00:0000042C 1D7C00C0003C    	   466:     move.b  #$c0,BLT_CTRL(a6)
                            	   467: 
                            	   468:     ; Band 2 ($50) vs Band 3 ($78): test bit 3 ($28 = %00101000 -> bit 3 = 1)
00:00000432 08060003        	   469:     btst    #3,d6
00:00000436 6632            	   470:     bne.s   .band3
                            	   471: 
                            	   472:     ; --- Band 2: Grass=1101, Kerb=1010, Asphalt=1001 ---
                            	   473:     ; P1 = 0 on Outer [left_x, right_x + kerb_w)
00:00000438 3010            	   474:     move.w  (a0),d0                     ; left_x
00:0000043A 32280002        	   475:     move.w  2(a0),d1                    ; right_x
00:0000043E D2680004        	   476:     add.w   4(a0),d1                    ; right_x + kerb_w
00:00000442 47EA0002        	   477:     lea     2(a2),a3                    ; plane 1
00:00000446 7400            	   478:     moveq   #0,d2                       ; OP = 0
00:00000448 610000B4        	   479:     bsr.w   blit_hspan
                            	   480: 
                            	   481:     ; Left kerb [left_x, left_x + kerb_w): P2 = 1, P3 = 0
00:0000044C 3010            	   482:     move.w  (a0),d0
00:0000044E 3200            	   483:     move.w  d0,d1
00:00000450 D2680004        	   484:     add.w   4(a0),d1
00:00000454 61000200        	   485:     bsr.w   blit_kerb_p2_1_p3_0
                            	   486: 
                            	   487:     ; Right kerb [right_x, right_x + kerb_w): P2 = 1, P3 = 0
00:00000458 30280002        	   488:     move.w  2(a0),d0
00:0000045C 3200            	   489:     move.w  d0,d1
00:0000045E D2680004        	   490:     add.w   4(a0),d1
00:00000462 610001F2        	   491:     bsr.w   blit_kerb_p2_1_p3_0
00:00000466 6000008A        	   492:     bra.w   .next_line
                            	   493: 
                            	   494: .band3:
                            	   495:     ; --- Band 3: Grass=1101, Kerb=1111, Asphalt=0101 ---
                            	   496:     ; P0 = 0 on Inner [left_x + kerb_w, right_x)
00:0000046A 3010            	   497:     move.w  (a0),d0
00:0000046C D0680004        	   498:     add.w   4(a0),d0
00:00000470 32280002        	   499:     move.w  2(a0),d1
00:00000474 264A            	   500:     movea.l a2,a3                       ; plane 0
00:00000476 7400            	   501:     moveq   #0,d2                       ; OP = 0
00:00000478 61000084        	   502:     bsr.w   blit_hspan
                            	   503: 
                            	   504:     ; Left kerb [left_x, left_x + kerb_w): P2 = 1
00:0000047C 3010            	   505:     move.w  (a0),d0
00:0000047E 3200            	   506:     move.w  d0,d1
00:00000480 D2680004        	   507:     add.w   4(a0),d1
00:00000484 47EA0004        	   508:     lea     4(a2),a3                    ; plane 2
00:00000488 740F            	   509:     moveq   #15,d2
00:0000048A 61000072        	   510:     bsr.w   blit_hspan
                            	   511: 
                            	   512:     ; Right kerb [right_x, right_x + kerb_w): P2 = 1
00:0000048E 30280002        	   513:     move.w  2(a0),d0
00:00000492 3200            	   514:     move.w  d0,d1
00:00000494 D2680004        	   515:     add.w   4(a0),d1
00:00000498 47EA0004        	   516:     lea     4(a2),a3                    ; plane 2
00:0000049C 740F            	   517:     moveq   #15,d2
00:0000049E 6100005E        	   518:     bsr.w   blit_hspan
00:000004A2 6000004E        	   519:     bra.w   .next_line
                            	   520: 
                            	   521: .grass_is_7:
                            	   522:     ; Test Band 0 ($00) vs Band 1 ($28): bit 3
00:000004A6 08060003        	   523:     btst    #3,d6
00:000004AA 6624            	   524:     bne.s   .band1
                            	   525: 
                            	   526:     ; --- Band 0: Grass=1110, Kerb=1010, Asphalt=1001 ---
                            	   527:     ; P1 = 0 on Outer [left_x, right_x + kerb_w)
00:000004AC 3010            	   528:     move.w  (a0),d0
00:000004AE 32280002        	   529:     move.w  2(a0),d1
00:000004B2 D2680004        	   530:     add.w   4(a0),d1
00:000004B6 47EA0002        	   531:     lea     2(a2),a3                    ; plane 1
00:000004BA 7400            	   532:     moveq   #0,d2
00:000004BC 61000040        	   533:     bsr.w   blit_hspan
                            	   534: 
                            	   535:     ; Inner [left_x + kerb_w, right_x): P2 = 0 AND P3 = 1 (share span calc!)
00:000004C0 3010            	   536:     move.w  (a0),d0
00:000004C2 D0680004        	   537:     add.w   4(a0),d0
00:000004C6 32280002        	   538:     move.w  2(a0),d1
00:000004CA 61000094        	   539:     bsr.w   blit_inner_p2_0_p3_1
00:000004CE 6022            	   540:     bra.s   .next_line
                            	   541: 
                            	   542: .band1:
                            	   543:     ; --- Band 1: Grass=1110, Kerb=1111, Asphalt=0101 ---
                            	   544:     ; P3 = 1 on Outer [left_x, right_x + kerb_w)
00:000004D0 3010            	   545:     move.w  (a0),d0
00:000004D2 32280002        	   546:     move.w  2(a0),d1
00:000004D6 D2680004        	   547:     add.w   4(a0),d1
00:000004DA 47EA0006        	   548:     lea     6(a2),a3                    ; plane 3
00:000004DE 740F            	   549:     moveq   #15,d2
00:000004E0 6100001C        	   550:     bsr.w   blit_hspan
                            	   551: 
                            	   552:     ; Inner [left_x + kerb_w, right_x): P0 = 0 AND P2 = 0 (share span calc!)
00:000004E4 3010            	   553:     move.w  (a0),d0
00:000004E6 D0680004        	   554:     add.w   4(a0),d0
00:000004EA 32280002        	   555:     move.w  2(a0),d1
00:000004EE 610000EE        	   556:     bsr.w   blit_inner_p0_0_p2_0
                            	   557: 
                            	   558: .next_line:
00:000004F2 5088            	   559:     addq.l  #8,a0
00:000004F4 45EA00A0        	   560:     lea     160(a2),a2
00:000004F8 51CFFEE4        	   561:     dbra    d7,.line_loop
                            	   562: .road_rts:
00:000004FC 4E75            	   563:     rts
                            	   564: 
                            	   565: ; ============================================================================
                            	   566: ; Span Blitter Helpers (a4=left_mask, a5=right_mask, a6=$ffff8a00)
                            	   567: ; Input: d0.w = x_start, d1.w = x_end (exclusive), a3 = scanline + plane*2, d2.b = OP
                            	   568: ; ============================================================================
                            	   569: blit_hspan:
00:000004FE 4A40            	   570:     tst.w   d0
00:00000500 6C02            	   571:     bge.s   .bh_l_ok
00:00000502 7000            	   572:     moveq   #0,d0
                            	   573: .bh_l_ok:
00:00000504 B27C0140        	   574:     cmp.w   #320,d1
00:00000508 6F04            	   575:     ble.s   .bh_r_ok
00:0000050A 323C0140        	   576:     move.w  #320,d1
                            	   577: .bh_r_ok:
00:0000050E B041            	   578:     cmp.w   d1,d0
00:00000510 6C4C            	   579:     bge.s   .bh_ret
00:00000512 5341            	   580:     subq.w  #1,d1                       ; inclusive x_end
                            	   581: 
00:00000514 3600            	   582:     move.w  d0,d3
00:00000516 C67C000F        	   583:     and.w   #15,d3
00:0000051A D643            	   584:     add.w   d3,d3
00:0000051C 38343000        	   585:     move.w  (a4,d3.w),d4                ; em1
                            	   586: 
00:00000520 3601            	   587:     move.w  d1,d3
00:00000522 C67C000F        	   588:     and.w   #15,d3
00:00000526 D643            	   589:     add.w   d3,d3
00:00000528 3A353000        	   590:     move.w  (a5,d3.w),d5                ; em3
                            	   591: 
00:0000052C E848            	   592:     lsr.w   #4,d0                       ; w_start
00:0000052E E849            	   593:     lsr.w   #4,d1                       ; w_end
00:00000530 9240            	   594:     sub.w   d0,d1                       ; w_end - w_start
00:00000532 6602            	   595:     bne.s   .bh_multi
00:00000534 C845            	   596:     and.w   d5,d4                       ; single word: em1 &= em3
                            	   597: .bh_multi:
00:00000536 5241            	   598:     addq.w  #1,d1                       ; x_cnt
00:00000538 E740            	   599:     asl.w   #3,d0                       ; w_start * 8
00:0000053A 43F30000        	   600:     lea     (a3,d0.w),a1
00:0000053E 3D440028        	   601:     move.w  d4,BLT_ENDMASK1(a6)
00:00000542 3D45002C        	   602:     move.w  d5,BLT_ENDMASK3(a6)
00:00000546 2D490032        	   603:     move.l  a1,BLT_DST_ADDR(a6)
00:0000054A 3D410036        	   604:     move.w  d1,BLT_X_CNT(a6)
00:0000054E 3D7C00010038    	   605:     move.w  #1,BLT_Y_CNT(a6)
00:00000554 1D42003B        	   606:     move.b  d2,BLT_OP(a6)
00:00000558 1D7C00C0003C    	   607:     move.b  #$c0,BLT_CTRL(a6)           ; tiny 1-line span (~16-80 cyc)
                            	   608: .bh_ret:
00:0000055E 4E75            	   609:     rts
                            	   610: 
                            	   611: ; Shared 2-plane inner span helper: P2 = 0, P3 = 1 (Band 0)
                            	   612: blit_inner_p2_0_p3_1:
00:00000560 4A40            	   613:     tst.w   d0
00:00000562 6C02            	   614:     bge.s   .i0_l
00:00000564 7000            	   615:     moveq   #0,d0
                            	   616: .i0_l:

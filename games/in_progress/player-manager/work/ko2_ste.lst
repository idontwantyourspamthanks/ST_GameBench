00:000AF0A0 3403            	   659:         move.w  d3,d2                   ; d2 = ty_top
00:000AF0A2 7009            	   660:         moveq   #9,d0                   ; cmd 9 = blit_col(d1=tx, d2=ty_top)
00:000AF0A4 4E48            	   661:         trap    #8
00:000AF0A6 4CDF030F        	   662:         movem.l (sp)+,d0-d3/a0-a1

                            	   268: ; ---------------------------------------------------------------------------
                            	   269: ; VBL Top ($018d06) & End ($018e0a): STE Shifter, Palette, & DMA Sound Step
                            	   270: ; ---------------------------------------------------------------------------
                            	   271: ste_vbl_top:
00:000AEC36 48E7C000        	   272:         movem.l d0-d1,-(sp)
00:000AEC3A 4A79000AE964    	   273:         tst.w   STE_AMIGA_ON
00:000AEC40 670000CA        	   274:         beq.w   .vt_classic
00:000AEC44 4A790002356A    	   275:         tst.w   $02356a.l               ; KO2 -$4f40(a4): Half-Time/Full-Time/Stats on $078000?
00:000AEC4A 66000092        	   276:         bne.w   .vt_stats
                            	   277: 
                            	   278:         ; Amiga STE Mode: disable Timer B stripes, program STE Shifter + Palette 0..7!
00:000AEC4E 423900FFFA1B    	   279:         clr.b   $00fffa1b.l             ; stop Timer B
                            	   280:         ; Capture Classic ST palette 0..7 once (before we overwrite $ff8240..$ff824e!)
00:000AEC54 4A79000AE984    	   281:         tst.w   STE_ST_PAL_OK

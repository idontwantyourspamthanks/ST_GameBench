                            	   354: ; ============================================================================
                            	   355: ; do_sky_blitter — STE Blitter replacement for sky fill ($00e7da..$00e82c)
                            	   356: ; Fills horizon_y ($1742c) lines * 160 B with color 7 ($ffff,$ffff,$ffff,$0000)
                            	   357: ; ============================================================================
                            	   358: do_sky_blitter:
00:000002E6 227AFD48        	   359:     movea.l ptr_game_base(pc),a1
00:000002EA 2069000E        	   360:     movea.l $0e(a1),a0                  ; *$aaa8 -> scanline ptr table
00:000002EE 2050            	   361:     movea.l (a0),a0                     ; screen base (y = 0)
00:000002F0 4DFAFD6E        	   362:     lea     has_blitter(pc),a6
00:000002F4 4A16            	   363:     tst.b   (a6)
00:000002F6 67000034        	   364:     beq.w   .sky_cpu
                            	   365: 
00:000002FA D3FC0000C992    	   366:     adda.l  #$c992,a1                   ; $1742c = horizon_y (lines)
00:00000300 3E11            	   367:     move.w  (a1),d7
00:00000302 6F22            	   368:     ble.s   .sky_done
                            	   369: 
00:00000304 4DF88A00        	   370:     lea     $ffff8a00.w,a6
00:00000308 3D7CFFFF0028    	   371:     move.w  #$ffff,BLT_ENDMASK1(a6)
00:0000030E 3D7CFFFF002A    	   372:     move.w  #$ffff,BLT_ENDMASK2(a6)
00:00000314 3D7CFFFF002C    	   373:     move.w  #$ffff,BLT_ENDMASK3(a6)
00:0000031A 422E003D        	   374:     clr.b   BLT_SKEW(a6)
00:0000031E 422E003A        	   375:     clr.b   BLT_HOP(a6)
00:00000322 6100FF56        	   376:     bsr.w   blt_fill_color7_hog
                            	   377: 
                            	   378: .sky_done:
00:00000326 207AFD20        	   379:     movea.l ptr_orig_sky_done(pc),a0
00:0000032A 4ED0            	   380:     jmp     (a0)
                            	   381: 
                            	   382: .sky_cpu:
00:0000032C 227AFD16        	   383:     movea.l ptr_orig_sky_cont(pc),a1
00:00000330 4ED1            	   384:     jmp     (a1)
                            	   385: 
                            	   386: ; ============================================================================
                            	   387: ; Endmask tables for STE Blitter horizontal spans (pixel 0..15)
                            	   388: ; ============================================================================
                            	   389: road_left_mask:
00:00000332 FFFF            	   390:     dc.w    $ffff,$7fff,$3fff,$1fff,$0fff,$07ff,$03ff,$01ff
00:00000334 7FFF
00:00000336 3FFF
00:00000338 1FFF
00:0000033A 0FFF
00:0000033C 07FF
00:0000033E 03FF
00:00000340 01FF
00:00000342 00FF            	   391:     dc.w    $00ff,$007f,$003f,$001f,$000f,$0007,$0003,$0001
00:00000344 007F
00:00000346 003F
00:00000348 001F
00:0000034A 000F
00:0000034C 0007
00:0000034E 0003
00:00000350 0001
                            	   392: 
                            	   393: road_right_mask:
00:00000352 8000            	   394:     dc.w    $8000,$c000,$e000,$f000,$f800,$fc00,$fe00,$ff00
00:00000354 C000
00:00000356 E000
00:00000358 F000
00:0000035A F800
00:0000035C FC00
00:0000035E FE00
00:00000360 FF00
00:00000362 FF80            	   395:     dc.w    $ff80,$ffc0,$ffe0,$fff0,$fff8,$fffc,$fffe,$ffff
00:00000364 FFC0
00:00000366 FFE0
00:00000368 FFF0
00:0000036A FFF8
00:0000036C FFFC
00:0000036E FFFE
00:00000370 FFFF

                            	   751: ; ============================================================================
                            	   752: ; do_gtos_init — replaces jsr $1c(a0) at +0x02de ($00ad78)
                            	   753: ; Calls original G.TOS table relocator, then precomputes 60 KB 1-plane masks
                            	   754: ; for all 4-plane interleaved sprite data in G.TOS ($3b000 / 8 = 30,208 words)
                            	   755: ; ============================================================================
                            	   756: do_gtos_init:
00:000006D4 4EA8001C        	   757:     jsr     $1c(a0)                     ; original G.TOS pointer-table relocator (returns table in a0)
00:000006D8 48E7C0E0        	   758:     movem.l d0-d1/a0-a2,-(sp)
00:000006DC 45FAF982        	   759:     lea     has_blitter(pc),a2
00:000006E0 4A12            	   760:     tst.b   (a2)
00:000006E2 671A            	   761:     beq.s   .no_masks
00:000006E4 207AF956        	   762:     movea.l ptr_g_tos_buf(pc),a0
00:000006E8 227AF966        	   763:     movea.l ptr_mask_buf(pc),a1
00:000006EC 323C75FF        	   764:     move.w  #(($3b000/8)-1),d1
                            	   765: .mk_mask:
00:000006F0 3018            	   766:     move.w  (a0)+,d0
00:000006F2 8058            	   767:     or.w    (a0)+,d0
00:000006F4 8058            	   768:     or.w    (a0)+,d0
00:000006F6 8058            	   769:     or.w    (a0)+,d0
00:000006F8 32C0            	   770:     move.w  d0,(a1)+
00:000006FA 51C9FFF4        	   771:     dbra    d1,.mk_mask
                            	   772: .no_masks:
00:000006FE 4CDF0703        	   773:     movem.l (sp)+,d0-d1/a0-a2
00:00000702 4E75            	   774:     rts
                            	   775: 
                            	   776: ; ============================================================================
                            	   777: ; do_mtn_blitter — STE Blitter replacement for parallax mountains ($00e122)
                            	   778: ; Inputs: d0 = scroll_x, d1 = height-1, d2 = y_start
                            	   779: ; ============================================================================
                            	   780: do_mtn_blitter:
00:00000704 4DFAF95A        	   781:     lea     has_blitter(pc),a6
00:00000708 4A16            	   782:     tst.b   (a6)
00:0000070A 6610            	   783:     bne.s   .mtn_blt
00:0000070C D241            	   784:     add.w   d1,d1
00:0000070E 2C7AF920        	   785:     movea.l ptr_game_base(pc),a6
00:00000712 4DEE36D8        	   786:     adda.l  #$36d8,a6                   ; $e172 jump table
00:00000716 207AF93C        	   787:     movea.l ptr_orig_mtn_cont(pc),a0
00:0000071A 4ED0            	   788:     jmp     (a0)
                            	   789: 
                            	   790: .mtn_blt:
                            	   791:     ; Compute preshifted buffer ptr a2 = preshift_tbl[d0 & 7] + *$dfd8
00:0000071C 3600            	   792:     move.w  d0,d3
00:0000071E C07C0007        	   793:     and.w   #7,d0
00:00000722 E540            	   794:     asl.w   #2,d0
00:00000724 207AF90A        	   795:     movea.l ptr_game_base(pc),a0
00:00000728 45E83542        	   796:     lea     $3542(a0),a2                ; $dfdc (preshift table)
00:0000072C 24720000        	   797:     movea.l (a2,d0.w),a2
00:00000730 D5E8353E        	   798:     adda.l  $353e(a0),a2                ; + *$dfd8 (bss_scratch_40k)
                            	   799: 
                            	   800:     ; Wrap table ptr a4 = $dffc + (0x50 - ((d3 >> 2) & 0xfe))
00:00000734 E443            	   801:     asr.w   #2,d3
00:00000736 C67C00FE        	   802:     and.w   #$fe,d3
00:0000073A 4443            	   803:     neg.w   d3
00:0000073C 06430050        	   804:     addi.w  #$50,d3
00:00000740 49E83562        	   805:     lea     $3562(a0),a4                ; $dffc (wrap table)
00:00000744 D8C3            	   806:     adda.w  d3,a4
                            	   807: 
                            	   808:     ; Screen dest a3 = (*$aaa8)[d2 * 4]
00:00000746 2668000E        	   809:     movea.l $0e(a0),a3                  ; *$aaa8
00:0000074A E542            	   810:     asl.w   #2,d2
00:0000074C 26732000        	   811:     movea.l (a3,d2.w),a3
                            	   812: 
                            	   813:     ; Setup Blitter for 20 columns of 4 words x (d1+1) lines
00:00000750 5241            	   814:     addq.w  #1,d1                       ; height in lines
00:00000752 4DF88A00        	   815:     lea     $ffff8a00.w,a6
00:00000756 3D7C00020020    	   816:     move.w  #2,BLT_SRC_XINC(a6)
00:0000075C 3D7C00020022    	   817:     move.w  #2,BLT_SRC_YINC(a6)
00:00000762 3D7CFFFF0028    	   818:     move.w  #$ffff,BLT_ENDMASK1(a6)
00:00000768 3D7CFFFF002A    	   819:     move.w  #$ffff,BLT_ENDMASK2(a6)
00:0000076E 3D7CFFFF002C    	   820:     move.w  #$ffff,BLT_ENDMASK3(a6)
00:00000774 3D7C0002002E    	   821:     move.w  #2,BLT_DST_XINC(a6)
00:0000077A 3D7C009A0030    	   822:     move.w  #154,BLT_DST_YINC(a6)       ; 160 - 3*2 = 154
00:00000780 1D7C0002003A    	   823:     move.b  #2,BLT_HOP(a6)              ; SRC only
00:00000786 1D7C0003003B    	   824:     move.b  #3,BLT_OP(a6)               ; replace
00:0000078C 422E003D        	   825:     clr.b   BLT_SKEW(a6)
                            	   826: 
00:00000790 7413            	   827:     moveq   #19,d2                      ; 20 columns
                            	   828: .mtn_col:
00:00000792 204A            	   829:     movea.l a2,a0
00:00000794 D0DC            	   830:     adda.w  (a4)+,a0
00:00000796 2D480024        	   831:     move.l  a0,BLT_SRC_ADDR(a6)
00:0000079A 2D4B0032        	   832:     move.l  a3,BLT_DST_ADDR(a6)
00:0000079E 3D7C00040036    	   833:     move.w  #4,BLT_X_CNT(a6)
00:000007A4 3D410038        	   834:     move.w  d1,BLT_Y_CNT(a6)
00:000007A8 1D7C00C0003C    	   835:     move.b  #$c0,BLT_CTRL(a6)           ; 64 words = ~512 cyc
00:000007AE 508B            	   836:     addq.l  #8,a3
00:000007B0 51CAFFE0        	   837:     dbra    d2,.mtn_col
00:000007B4 4E75            	   838:     rts

                            	    60: ; ============================================================================
                            	    61: ; do_patch_init — called instead of +0x0010e ($aba8) on startup (User mode)
                            	    62: ; ============================================================================
                            	    63: do_patch_init:
                            	    64:     ; 0. If G.TOS is not in CWD (e.g. launched from A:\AUTO\), switch to root "\"
00:00000084 3F3C0000        	    65:     move.w  #0,-(sp)                    ; read-only
00:00000088 487AFFF2        	    66:     pea     str_gtos_chk(pc)
00:0000008C 3F3C003D        	    67:     move.w  #$3d,-(sp)                  ; Fopen("G.TOS", 0)
00:00000090 4E41            	    68:     trap    #1
00:00000092 508F            	    69:     addq.l  #8,sp
00:00000094 4A80            	    70:     tst.l   d0
00:00000096 6B0C            	    71:     bmi.s   .try_root
00:00000098 3F00            	    72:     move.w  d0,-(sp)
00:0000009A 3F3C003E        	    73:     move.w  #$3e,-(sp)                  ; Fclose
00:0000009E 4E41            	    74:     trap    #1
00:000000A0 588F            	    75:     addq.l  #4,sp
00:000000A2 600C            	    76:     bra.s   .cwd_ok
                            	    77: .try_root:
00:000000A4 487AFFDC        	    78:     pea     str_root_dir(pc)
00:000000A8 3F3C003B        	    79:     move.w  #$3b,-(sp)                  ; Dsetpath("\")
00:000000AC 4E41            	    80:     trap    #1
00:000000AE 5C8F            	    81:     addq.l  #6,sp
                            	    82: .cwd_ok:
                            	    83: 
                            	    84:     ; 1. Save current video mode & screen bases, switch to ST Low if needed (TT/Med-res)
00:000000B0 3F3C0004        	    85:     move.w  #4,-(sp)                    ; XBIOS Getrez()
00:000000B4 4E4E            	    86:     trap    #14
00:000000B6 548F            	    87:     addq.l  #2,sp
00:000000B8 41FAFFAB        	    88:     lea     saved_rez(pc),a0
00:000000BC 1080            	    89:     move.b  d0,(a0)
                            	    90: 
00:000000BE 3F3C0002        	    91:     move.w  #2,-(sp)                    ; XBIOS Physbase()
00:000000C2 4E4E            	    92:     trap    #14
00:000000C4 548F            	    93:     addq.l  #2,sp
00:000000C6 41FAFFA0        	    94:     lea     saved_physbase(pc),a0
00:000000CA 2080            	    95:     move.l  d0,(a0)
                            	    96: 
00:000000CC 3F3C0003        	    97:     move.w  #3,-(sp)                    ; XBIOS Logbase()
00:000000D0 4E4E            	    98:     trap    #14
00:000000D2 548F            	    99:     addq.l  #2,sp
00:000000D4 41FAFF96        	   100:     lea     saved_logbase(pc),a0
00:000000D8 2080            	   101:     move.l  d0,(a0)
                            	   102: 
                            	   103:     ; 2. Compute 256-byte aligned triple screen buffers inside ptr_scr_bufs
00:000000DA 203AFF5C        	   104:     move.l  ptr_scr_bufs(pc),d0
00:000000DE D0BC000000FF    	   105:     add.l   #255,d0
00:000000E4 4200            	   106:     clr.b   d0                          ; 256-byte aligned
00:000000E6 41FAFF88        	   107:     lea     scr_addr_0(pc),a0
00:000000EA 20C0            	   108:     move.l  d0,(a0)+                    ; scr_addr_0
00:000000EC D0BC00007D00    	   109:     add.l   #32000,d0
00:000000F2 20C0            	   110:     move.l  d0,(a0)+                    ; scr_addr_1
00:000000F4 D0BC00007D00    	   111:     add.l   #32000,d0
00:000000FA 2080            	   112:     move.l  d0,(a0)                     ; scr_addr_2
                            	   113: 
                            	   114:     ; Clear all 3 screen buffers (96,000 bytes = 24,000 longs)
00:000000FC 207AFF72        	   115:     movea.l scr_addr_0(pc),a0
00:00000100 323C5DBF        	   116:     move.w  #24000-1,d1
                            	   117: .clr_scr:
00:00000104 4298            	   118:     clr.l   (a0)+
00:00000106 51C9FFFC        	   119:     dbra    d1,.clr_scr
                            	   120: 
                            	   121:     ; Store into Overlander header vars (+0x0e=$aaa8, +0x12=$aaac, +0x16=$aab0, +0x1a=$aab4)
00:0000010A 227AFF24        	   122:     movea.l ptr_game_base(pc),a1
00:0000010E 237AFF60000E    	   123:     move.l  scr_addr_0(pc),$0e(a1)      ; $aaa8
00:00000114 237AFF620012    	   124:     move.l  scr_addr_2(pc),$12(a1)      ; $aaac
00:0000011A 237AFF580016    	   125:     move.l  scr_addr_1(pc),$16(a1)      ; $aab0
00:00000120 237AFF52001A    	   126:     move.l  scr_addr_1(pc),$1a(a1)      ; $aab4
                            	   127: 
                            	   128:     ; 3. Switch to ST Low (rez=0) if not already ST Low (fixes TT VGA & Med-res)
00:00000126 41FAFF3D        	   129:     lea     saved_rez(pc),a0
00:0000012A 4A10            	   130:     tst.b   (a0)
00:0000012C 6716            	   131:     beq.s   .already_low
00:0000012E 3F3C0000        	   132:     move.w  #0,-(sp)                    ; ST Low
00:00000132 2F3AFF40        	   133:     move.l  scr_addr_1(pc),-(sp)        ; physloc
00:00000136 2F3AFF3C        	   134:     move.l  scr_addr_1(pc),-(sp)        ; logloc
00:0000013A 3F3C0005        	   135:     move.w  #5,-(sp)                    ; XBIOS Setscreen
00:0000013E 4E4E            	   136:     trap    #14
00:00000140 4FEF000C        	   137:     lea     12(sp),sp
                            	   138: .already_low:
                            	   139: 
                            	   140:     ; 4. Overlander installs its own IKBD handler ($0129e4) which parses joystick & mouse packets cleanly.
                            	   141:     ;    Do not send $12 before $0129e4 resets the ACIA.
                            	   142: 
                            	   143:     ; 5. Enter Supervisor briefly to inspect cookies (_MCH, _SND) & probe Blitter
00:00000144 42A7            	   144:     clr.l   -(sp)
00:00000146 3F3C0020        	   145:     move.w  #$20,-(sp)                  ; GEMDOS Super(0)
00:0000014A 4E41            	   146:     trap    #1
00:0000014C 5C8F            	   147:     addq.l  #6,sp
00:0000014E 2F00            	   148:     move.l  d0,-(sp)                    ; save old SSP
                            	   149: 
00:00000150 610E            	   150:     bsr.s   detect_hardware
                            	   151: 
00:00000152 3F3C0020        	   152:     move.w  #$20,-(sp)                  ; GEMDOS Super(old_ssp)
00:00000156 4E41            	   153:     trap    #1
00:00000158 5C8F            	   154:     addq.l  #6,sp
                            	   155: 
                            	   156:     ; 6. Jump to original Overlander startup (+0x0010e)
00:0000015A 207AFED8        	   157:     movea.l ptr_orig_start(pc),a0
00:0000015E 4ED0            	   158:     jmp     (a0)
                            	   159: 
                            	   160: ; ============================================================================
                            	   161: ; detect_hardware — Supervisor mode: detect _MCH, _SND, Blitter
                            	   162: ; ============================================================================
                            	   163: detect_hardware:
00:00000160 48E7F0E0        	   164:     movem.l d0-d3/a0-a2,-(sp)
00:00000164 45FAFEFA        	   165:     lea     has_blitter(pc),a2
00:00000168 4292            	   166:     clr.l   (a2)                        ; clear has_blitter, has_dma, is_tt, is_falcon
                            	   167: 
                            	   168:     ; Read cookie jar ($5a0.w)
00:0000016A 203805A0        	   169:     move.l  $5a0.w,d0
00:0000016E 6744            	   170:     beq.s   .no_jar
00:00000170 2040            	   171:     movea.l d0,a0
                            	   172: .jar_loop:
00:00000172 2218            	   173:     move.l  (a0)+,d1
00:00000174 673E            	   174:     beq.s   .no_jar
00:00000176 2418            	   175:     move.l  (a0)+,d2
00:00000178 B2BC5F4D4348    	   176:     cmp.l   #'_MCH',d1
00:0000017E 661E            	   177:     bne.s   .chk_snd
00:00000180 4842            	   178:     swap    d2
00:00000182 B47C0002        	   179:     cmp.w   #2,d2
00:00000186 6608            	   180:     bne.s   .chk_falc
00:00000188 157C00010002    	   181:     move.b  #1,2(a2)                    ; is_tt = 1
00:0000018E 60E2            	   182:     bra.s   .jar_loop
                            	   183: .chk_falc:
00:00000190 B47C0003        	   184:     cmp.w   #3,d2
00:00000194 66DC            	   185:     bne.s   .jar_loop
00:00000196 157C00010003    	   186:     move.b  #1,3(a2)                    ; is_falcon = 1
00:0000019C 60D4            	   187:     bra.s   .jar_loop
                            	   188: .chk_snd:
00:0000019E B2BC5F534E44    	   189:     cmp.l   #'_SND',d1
00:000001A4 66CC            	   190:     bne.s   .jar_loop
00:000001A6 08020001        	   191:     btst    #1,d2                       ; bit 1 = STE/TT/Falcon DMA sound
00:000001AA 67C6            	   192:     beq.s   .jar_loop
00:000001AC 157C00010001    	   193:     move.b  #1,1(a2)                    ; has_dma = 1
00:000001B2 60BE            	   194:     bra.s   .jar_loop
                            	   195: .no_jar:
                            	   196: 
                            	   197:     ; Safe Blitter probe ($ffff8a3c.w) with bus-error trap
00:000001B4 40E7            	   198:     move.w  sr,-(sp)
00:000001B6 007C0700        	   199:     ori.w   #$0700,sr
00:000001BA 22780008        	   200:     move.l  $8.w,a1                     ; save Bus Error vector
00:000001BE 41FA001E        	   201:     lea     .blt_berr(pc),a0
00:000001C2 21C80008        	   202:     move.l  a0,$8.w
00:000001C6 204F            	   203:     movea.l sp,a0                       ; save SP
00:000001C8 4A388A3C        	   204:     tst.b   $ffff8a3c.w                 ; probe Blitter LINE_NUM/CTRL
00:000001CC 14BC0001        	   205:     move.b  #1,(a2)                     ; succeeded -> has_blitter = 1
                            	   206: .blt_done:
00:000001D0 2E48            	   207:     movea.l a0,sp
00:000001D2 21C90008        	   208:     move.l  a1,$8.w
00:000001D6 46DF            	   209:     move.w  (sp)+,sr
00:000001D8 4CDF070F        	   210:     movem.l (sp)+,d0-d3/a0-a2
00:000001DC 4E75            	   211:     rts
                            	   212: .blt_berr:
00:000001DE 60F0            	   213:     bra.s   .blt_done
                            	   214: 
                            	   215: ; ============================================================================
                            	   216: ; do_tb_wait / do_tb_wake — 68030 I-cache-safe replacement for $b822/$b834/$b840
                            	   217: ; Replaces: move.w #$60fe, $b834.l ... bra.b $b834 / move.w #$6002, $b834.l
                            	   218: ; ============================================================================
                            	   219: do_tb_wait:
00:000001E0 41FAFE82        	   220:     lea     tb_sync_flag(pc),a0         ; note: caller $b7f0 doesn't rely on a0 across wait
00:000001E4 4210            	   221:     clr.b   (a0)
00:000001E6 08B80000FA0F    	   222:     bclr.b  #0,$fffffa0f.w              ; clear Timer B ISR
00:000001EC 46FC2300        	   223:     move.w  #$2300,sr
                            	   224: .wait_tb:
00:000001F0 4A10            	   225:     tst.b   (a0)
00:000001F2 67FC            	   226:     beq.s   .wait_tb
00:000001F4 08B80000FA0F    	   227:     bclr.b  #0,$fffffa0f.w
00:000001FA 4E75            	   228:     rts
                            	   229: 
                            	   230: do_tb_wake:
                            	   231:     ; Called via jsr from $b840 (Timer B ISR) — preserve ALL registers!
00:000001FC 2F08            	   232:     move.l  a0,-(sp)
00:000001FE 41FAFE64        	   233:     lea     tb_sync_flag(pc),a0
00:00000202 50D0            	   234:     st      (a0)
00:00000204 205F            	   235:     move.l  (sp)+,a0
00:00000206 4E75            	   236:     rts
                            	   237: 
                            	   238: ; ============================================================================
                            	   239: ; do_frame_flip — replaces sub_00af5a (+0x004c0) with clean VBL pacing
                            	   240: ; ============================================================================
                            	   241: do_frame_flip:
00:00000208 207AFE26        	   242:     movea.l ptr_game_base(pc),a0
                            	   243: .wait_lock:
00:0000020C 082800020004    	   244:     btst.b  #2,$04(a0)                  ; $aa9e bit 2
00:00000212 66F8            	   245:     bne.s   .wait_lock
                            	   246: .wait_vbl:
00:00000214 4A680006        	   247:     tst.w   $06(a0)                     ; $aaa0 (decremented every VBL)
00:00000218 66FA            	   248:     bne.s   .wait_vbl
                            	   249: 
                            	   250:     ; Triple-buffer rotation ($aaa8, $aaac, $aab0 -> $aab4)
00:0000021A 2268000E        	   251:     move.l  $0e(a0),a1                  ; a1 = old $aaa8
00:0000021E 21680012000E    	   252:     move.l  $12(a0),$0e(a0)             ; $aaa8 = old $aaac
00:00000224 216800160012    	   253:     move.l  $16(a0),$12(a0)             ; $aaac = old $aab0
00:0000022A 21490016        	   254:     move.l  a1,$16(a0)                  ; $aab0 = old $aaa8
00:0000022E 2151001A        	   255:     move.l  (a1),$1a(a0)                ; $aab4 = *(old $aaa8) (screen base)
00:00000232 317AFE320006    	   256:     move.w  pace_vbls(pc),$06(a0)       ; $aaa0 = 2 VBLs (25.0 fps cap)
00:00000238 5268000A        	   257:     addq.w  #1,$0a(a0)                  ; $aaa4++ (FPS counter)
00:0000023C 4E75            	   258:     rts
                            	   259: 
                            	   260: ; ============================================================================
                            	   261: ; do_scale_loop — 68030 I-cache-safe replacement for $00e2e0..$00e31a
                            	   262: ; Replaces self-modifying `subi.w #imm,d6` / `addi.w #imm,d6`
                            	   263: ; Inputs: (a0)=orig_h, d2=scaled_h, d3=draw_h-1, a2=src, a3=src_stride, a5=dst, a6=row_fn
                            	   264: ; ============================================================================
00:0000023E 0000            	   265: scale_add_val:          dc.w    0
00:00000240 0000            	   266: scale_sub_val:          dc.w    0
                            	   267: 
                            	   268: do_scale_loop:
00:00000242 3C10            	   269:     move.w  (a0),d6                     ; orig_h
00:00000244 49FAFFF8        	   270:     lea     scale_add_val(pc),a4
00:00000248 3886            	   271:     move.w  d6,(a4)                     ; scale_add_val = orig_h
00:0000024A 3006            	   272:     move.w  d6,d0
00:0000024C 9042            	   273:     sub.w   d2,d0
00:0000024E 39400002        	   274:     move.w  d0,2(a4)                    ; scale_sub_val = orig_h - scaled_h
00:00000252 E246            	   275:     asr.w   #1,d6                       ; d6 = orig_h / 2
00:00000254 49FA000C        	   276:     lea     .row_ret(pc),a4
00:00000258 3E03            	   277:     move.w  d3,d7
00:0000025A 6B1C            	   278:     bmi.s   .scale_done
                            	   279: .row_loop:
00:0000025C 204A            	   280:     movea.l a2,a0
00:0000025E 224D            	   281:     movea.l a5,a1
00:00000260 4ED6            	   282:     jmp     (a6)                        ; row_fn returns via jmp (a4)
                            	   283: .row_ret:
00:00000262 D4CB            	   284:     adda.w  a3,a2
00:00000264 4BED00A0        	   285:     lea     $a0(a5),a5
00:00000268 9C7AFFD6        	   286:     sub.w   scale_sub_val(pc),d6
00:0000026C 6E06            	   287:     bgt.s   .no_skip
00:0000026E DC7AFFCE        	   288:     add.w   scale_add_val(pc),d6
00:00000272 D4CB            	   289:     adda.w  a3,a2
                            	   290: .no_skip:
00:00000274 51CFFFE6        	   291:     dbra    d7,.row_loop
                            	   292: .scale_done:
00:00000278 4E75            	   293:     rts
                            	   294: 
                            	   295: ; ============================================================================
                            	   296: ; STE Blitter Register Offsets (from a6 = $ffff8a00)
                            	   297: ; ============================================================================
                            	   298: BLT_SRC_XINC    equ $20
                            	   299: BLT_SRC_YINC    equ $22
                            	   300: BLT_SRC_ADDR    equ $24
                            	   301: BLT_ENDMASK1    equ $28
                            	   302: BLT_ENDMASK2    equ $2a
                            	   303: BLT_ENDMASK3    equ $2c
                            	   304: BLT_DST_XINC    equ $2e
                            	   305: BLT_DST_YINC    equ $30
                            	   306: BLT_DST_ADDR    equ $32
                            	   307: BLT_X_CNT       equ $36
                            	   308: BLT_Y_CNT       equ $38
                            	   309: BLT_HOP         equ $3a
                            	   310: BLT_OP          equ $3b
                            	   311: BLT_CTRL        equ $3c
                            	   312: BLT_SKEW        equ $3d
                            	   313: 
                            	   314: ; Helper: fill d7 lines at a0 with color 7 ($ffff,$ffff,$ffff,$0000) in 8-line HOG chunks
                            	   315: ; Clobbers d0-d1/a0-a1; expects a6 = $ffff8a00, ENDMASK1/2/3=$ffff, HOP=0, SKEW=0
                            	   316: blt_fill_color7_hog:
00:0000027A 3D7C0002002E    	   317:     move.w  #2,BLT_DST_XINC(a6)
00:00000280 3D7C00020030    	   318:     move.w  #2,BLT_DST_YINC(a6)
00:00000286 2D480032        	   319:     move.l  a0,BLT_DST_ADDR(a6)
00:0000028A 1D7C000F003B    	   320:     move.b  #15,BLT_OP(a6)
00:00000290 3007            	   321:     move.w  d7,d0
                            	   322: .f7_p1:
00:00000292 7208            	   323:     moveq   #8,d1
00:00000294 B041            	   324:     cmp.w   d1,d0
00:00000296 6C02            	   325:     bge.s   .f7_p1_go
00:00000298 3200            	   326:     move.w  d0,d1
                            	   327: .f7_p1_go:
00:0000029A 3D7C00500036    	   328:     move.w  #80,BLT_X_CNT(a6)
00:000002A0 3D410038        	   329:     move.w  d1,BLT_Y_CNT(a6)
00:000002A4 1D7C00C0003C    	   330:     move.b  #$c0,BLT_CTRL(a6)
00:000002AA 9041            	   331:     sub.w   d1,d0
00:000002AC 6EE4            	   332:     bgt.s   .f7_p1
                            	   333: 
                            	   334:     ; Pass 2: clear plane 3 (20 words/line * d7 lines, 16-line HOG chunks)
00:000002AE 3D7C0008002E    	   335:     move.w  #8,BLT_DST_XINC(a6)
00:000002B4 3D7C00080030    	   336:     move.w  #8,BLT_DST_YINC(a6)
00:000002BA 43E80006        	   337:     lea     6(a0),a1
00:000002BE 2D490032        	   338:     move.l  a1,BLT_DST_ADDR(a6)
00:000002C2 422E003B        	   339:     clr.b   BLT_OP(a6)
00:000002C6 3007            	   340:     move.w  d7,d0
                            	   341: .f7_p2:
00:000002C8 7210            	   342:     moveq   #16,d1
00:000002CA B041            	   343:     cmp.w   d1,d0
00:000002CC 6C02            	   344:     bge.s   .f7_p2_go
00:000002CE 3200            	   345:     move.w  d0,d1
                            	   346: .f7_p2_go:
00:000002D0 3D7C00140036    	   347:     move.w  #20,BLT_X_CNT(a6)
00:000002D6 3D410038        	   348:     move.w  d1,BLT_Y_CNT(a6)
00:000002DA 1D7C00C0003C    	   349:     move.b  #$c0,BLT_CTRL(a6)
00:000002E0 9041            	   350:     sub.w   d1,d0
00:000002E2 6EE4            	   351:     bgt.s   .f7_p2
00:000002E4 4E75            	   352:     rts

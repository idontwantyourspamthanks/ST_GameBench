00:00000060 00              	    44: has_blitter:            dc.b    0
00:00000061 00              	    45: has_dma:                dc.b    0
00:00000062 00              	    46: is_tt:                  dc.b    0
00:00000063 00              	    47: is_falcon:              dc.b    0
00:00000064 00              	    48: tb_sync_flag:           dc.b    0
00:00000065 00              	    49: saved_rez:              dc.b    0
00:00000066 0002            	    50: pace_vbls:              dc.w    2                       ; 2 VBLs = 25.0 fps (50 Hz) / 30.0 fps (60 Hz)
00:00000068 00000000        	    51: saved_physbase:         dc.l    0
00:0000006C 00000000        	    52: saved_logbase:          dc.l    0

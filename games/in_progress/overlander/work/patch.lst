Source: "games/in_progress/overlander/patches/overlander_patch.s"
                            	     1: ; Overlander — STE/TT/Falcon Compatibility & Enhancement Patch
                            	     2: ; Assembled with: vasmm68k_mot -Fbin -spaces -m68000 -o patch.bin overlander_patch.s
                            	     3: ; Placed immediately at TEXT_END (+0x12e40) of OVERLAND_orig.PRG.
                            	     4: ; Build script injects exact symbol addresses via header table at offset 0.
                            	     5: 
                            	     6:     org     0
                            	     7: 
                            	     8: ; ============================================================================
                            	     9: ; Header / Jump Table (fixed offsets from patch_base)
                            	    10: ; ============================================================================
00:00000000 60000082        	    11: patch_entry_init:       bra.w   do_patch_init           ; +0x0000
00:00000004 600001DA        	    12: patch_entry_tb_wait:    bra.w   do_tb_wait              ; +0x0004
00:00000008 600001F2        	    13: patch_entry_tb_wake:    bra.w   do_tb_wake              ; +0x0008
00:0000000C 600001FA        	    14: patch_entry_flip:       bra.w   do_frame_flip           ; +0x000c
00:00000010 60000A30        	    15: patch_entry_exit:       bra.w   do_patch_exit           ; +0x0010
00:00000014 6000022C        	    16: patch_entry_scale:      bra.w   do_scale_loop           ; +0x0014
00:00000018 600002CC        	    17: patch_entry_sky:        bra.w   do_sky_blitter          ; +0x0018
00:0000001C 60000354        	    18: patch_entry_road:       bra.w   do_road_blitter         ; +0x001c
00:00000020 600006B2        	    19: patch_entry_gtos_init:  bra.w   do_gtos_init            ; +0x0020
00:00000024 600006DE        	    20: patch_entry_mtn:        bra.w   do_mtn_blitter          ; +0x0024
00:00000028 6000078C        	    21: patch_entry_spr_aln:    bra.w   do_spr_aligned_blt      ; +0x0028

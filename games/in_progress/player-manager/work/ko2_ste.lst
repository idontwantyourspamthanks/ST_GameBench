                            	   247: ste_play_sound_hi:
00:000AEBE6 4A6CA114        	   248:         tst.w   -$5eec(a4)
00:000AEBEA 662E            	   249:         bne.s   ste_ps_rts
00:000AEBEC 4AB9000AE950    	   250:         tst.l   STE_SND_BASE
00:000AEBF2 6726            	   251:         beq.s   ste_ps_rts
00:000AEBF4 23CA000AE954    	   252:         move.l  a2,STE_SCRIPT_ST
00:000AEBFA 23CA000AE958    	   253:         move.l  a2,STE_SCRIPT_PTR
00:000AEC00 4279000AE95C    	   254:         clr.w   STE_REPEAT_CNT
00:000AEC06 397C0001EBD6    	   255:         move.w  #1,-$142a(a4)
00:000AEC0C 4239000AE95F    	   256:         clr.b   STE_SND_STOP
00:000AEC12 13FC0001000AE95E	   257:         move.b  #1,STE_SND_PEND
                            	   258: ste_ps_rts:
00:000AEC1A 4E75            	   259:         rts
                            	   260: 
                            	   261: ste_stop_sound:

diff --git a/api/app/services/hub/ncmp/doors.rb b/api/app/services/hub/ncmp/doors.rb
new file mode 100644
index 0000000..34ca8d4
--- /dev/null
+++ b/api/app/services/hub/ncmp/doors.rb
@@ -0,0 +1,59 @@
+module Hub
+  module Ncmp
+    # Door openings ($83, drawn by the game as a dark gap) are the tunnel doors. The frog pressing Up in one walks through
+    # the tower and comes out half the ring away: x + 64 of 128, i.e. column + 8 (mod 16), SAME row, whether or not a door
+    # is there (the game never looks at the destination before it moves the frog; work/looks/deliver3/doors_notes.md).
+    # So a door is "paired" when the cell 8 columns away on the same row is a door opening too; the original towers (176
+    # of 178 door runs; the other two have the tower's exit door opposite) and the in-game editor (it places the opposite
+    # door itself) always pair them. A door opening without a door (opening or exit) opposite is the warning
+    # `unpaired_door`. The exit door ($c3, the finish) is not a tunnel and needs no partner.
+    module Doors
+      UNPAIRED = "unpaired_door".freeze
+
+      module_function
+
+      def opposite(col)
+        (col + Parser::ANGLES / 2) % Parser::ANGLES
+      end
+
+      def opening?(v)
+        Legend.tile_for(v) == 7
+      end
+
+      # a door of either kind is somewhere the frog can come out "in a door"
+      def door?(v)
+        (7..8).cover?(Legend.tile_for(v))
+      end
+
+      # -> [{col:, bottom:, top:, partner_col:, paired:, missing: [rows without an opposite door], warnings: ["unpaired_door"]}]
+      # one entry per run of vertically adjacent door-opening cells in a column
+      def report(grid, rows)
+        out = []
+        Parser::ANGLES.times do |c|
+          cl = grid[c]
+          p = opposite(c)
+          r = 0
+          while r < rows
+            unless opening?(cl[r])
+              r += 1
+              next
+            end
+
+            top = r
+            top += 1 while top + 1 < rows && opening?(cl[top + 1])
+            missing = (r..top).reject { |row| door?(grid[p][row]) }
+            out << { col: c, bottom: r, top: top, partner_col: p, paired: missing.empty?, missing: missing,
+                     warnings: missing.empty? ? [] : [ UNPAIRED ] }
+            r = top + 1
+          end
+        end
+        out
+      end
+
+      def message(door)
+        rows = door[:bottom] == door[:top] ? "row #{door[:bottom]}" : "rows #{door[:bottom]}-#{door[:top]}"
+        "door in column #{door[:col]}, #{rows}: no door opposite in column #{door[:partner_col]} (#{UNPAIRED}); the frog comes out of the tunnel there all the same"
+      end
+    end
+  end
+end

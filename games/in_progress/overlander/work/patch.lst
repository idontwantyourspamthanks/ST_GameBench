                            	   840: ; ============================================================================
                            	   841: ; do_spr_aligned_blt — STE Blitter replacement for sub_00dcc2 (+0x3228)
                            	   842: ; Inputs: a0 = src (4-plane contiguous), a1 = dst screen, d6 = width_words-1, d7 = height-1
                            	   843: ; ============================================================================
                            	   844: do_spr_aligned_blt:
00:000007B6 4DFAF8A8        	   845:     lea     has_blitter(pc),a6
00:000007BA 4A16            	   846:     tst.b   (a6)
00:000007BC 670000C2        	   847:     beq.w   .sa_cpu
                            	   848: 
                            	   849:     ; Check if a0 is inside [ptr_g_tos_buf, ptr_g_tos_buf + $3b000)
00:000007C0 2008            	   850:     move.l  a0,d0
00:000007C2 90BAF878        	   851:     sub.l   ptr_g_tos_buf(pc),d0
00:000007C6 6B0000B8        	   852:     bmi.w   .sa_cpu
00:000007CA B0BC0003B000    	   853:     cmp.l   #$3b000,d0
00:000007D0 640000AE        	   854:     bhs.w   .sa_cpu
                            	   855: 
                            	   856:     ; Mask address a2 = ptr_mask_buf + (d0 >> 2)
00:000007D4 E488            	   857:     lsr.l   #2,d0
00:000007D6 247AF878        	   858:     movea.l ptr_mask_buf(pc),a2
00:000007DA D5C0            	   859:     adda.l  d0,a2
                            	   860: 
00:000007DC 5246            	   861:     addq.w  #1,d6                       ; x_cnt (words)
00:000007DE 5247            	   862:     addq.w  #1,d7                       ; y_cnt (lines)
00:000007E0 3206            	   863:     move.w  d6,d1
00:000007E2 5341            	   864:     subq.w  #1,d1
00:000007E4 E741            	   865:     asl.w   #3,d1                       ; (x_cnt - 1) * 8
00:000007E6 343C00A0        	   866:     move.w  #160,d2
00:000007EA 9441            	   867:     sub.w   d1,d2                       ; dst_yinc = 160 - (x_cnt-1)*8
                            	   868: 
00:000007EC 4DF88A00        	   869:     lea     $ffff8a00.w,a6
00:000007F0 3D7CFFFF0028    	   870:     move.w  #$ffff,BLT_ENDMASK1(a6)
00:000007F6 3D7CFFFF002A    	   871:     move.w  #$ffff,BLT_ENDMASK2(a6)
00:000007FC 3D7CFFFF002C    	   872:     move.w  #$ffff,BLT_ENDMASK3(a6)
00:00000802 3D7C0008002E    	   873:     move.w  #8,BLT_DST_XINC(a6)
00:00000808 3D420030        	   874:     move.w  d2,BLT_DST_YINC(a6)
00:0000080C 1D7C0002003A    	   875:     move.b  #2,BLT_HOP(a6)
00:00000812 422E003D        	   876:     clr.b   BLT_SKEW(a6)
                            	   877: 
                            	   878:     ; Pass 1: Mask cut (~SRC & DST, OP=4) across all 4 planes
00:00000816 3D7C00020020    	   879:     move.w  #2,BLT_SRC_XINC(a6)
00:0000081C 3D7C00020022    	   880:     move.w  #2,BLT_SRC_YINC(a6)
00:00000822 1D7C0004003B    	   881:     move.b  #4,BLT_OP(a6)
00:00000828 2649            	   882:     movea.l a1,a3
00:0000082A 7603            	   883:     moveq   #3,d3
                            	   884: .sa_mask_lp:
00:0000082C 2D4A0024        	   885:     move.l  a2,BLT_SRC_ADDR(a6)
00:00000830 2D4B0032        	   886:     move.l  a3,BLT_DST_ADDR(a6)
00:00000834 3D460036        	   887:     move.w  d6,BLT_X_CNT(a6)
00:00000838 3D470038        	   888:     move.w  d7,BLT_Y_CNT(a6)
00:0000083C 1D7C00C0003C    	   889:     move.b  #$c0,BLT_CTRL(a6)
00:00000842 548B            	   890:     addq.l  #2,a3
00:00000844 51CBFFE6        	   891:     dbra    d3,.sa_mask_lp
                            	   892: 
                            	   893:     ; Pass 2: Sprite OR (SRC | DST, OP=7) across all 4 planes
00:00000848 3D7C00080020    	   894:     move.w  #8,BLT_SRC_XINC(a6)
00:0000084E 3D7C00080022    	   895:     move.w  #8,BLT_SRC_YINC(a6)
00:00000854 1D7C0007003B    	   896:     move.b  #7,BLT_OP(a6)
00:0000085A 2448            	   897:     movea.l a0,a2
00:0000085C 2649            	   898:     movea.l a1,a3
00:0000085E 7603            	   899:     moveq   #3,d3
                            	   900: .sa_or_lp:
00:00000860 2D4A0024        	   901:     move.l  a2,BLT_SRC_ADDR(a6)
00:00000864 2D4B0032        	   902:     move.l  a3,BLT_DST_ADDR(a6)
00:00000868 3D460036        	   903:     move.w  d6,BLT_X_CNT(a6)
00:0000086C 3D470038        	   904:     move.w  d7,BLT_Y_CNT(a6)
00:00000870 1D7C00C0003C    	   905:     move.b  #$c0,BLT_CTRL(a6)
00:00000876 548A            	   906:     addq.l  #2,a2
00:00000878 548B            	   907:     addq.l  #2,a3
00:0000087A 51CBFFE4        	   908:     dbra    d3,.sa_or_lp
00:0000087E 4E75            	   909:     rts
                            	   910: 
                            	   911: .sa_cpu:
00:00000880 267AF7AE        	   912:     movea.l ptr_game_base(pc),a3

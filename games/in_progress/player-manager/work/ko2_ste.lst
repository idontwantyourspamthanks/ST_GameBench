00:000AEC22 4239000AE95E    	   263:         clr.b   STE_SND_PEND
00:000AEC28 13FC0001000AE95F	   264:         move.b  #1,STE_SND_STOP
00:000AEC30 426CEBD6        	   265:         clr.w   -$142a(a4)
